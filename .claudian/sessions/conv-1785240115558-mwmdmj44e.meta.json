            "result": "1749\t    \"question\": \"SIMD结构通常由[F##一个指令控制部件、多个处理单元]组成\",\n1750\t    \"answer\": \"\"\n1751\t  },\n1752\t  {\n1753\t    \"category\": \"计组\",\n1754\t    \"question\": \"SIMD结构每个处理单元都有[F##自己的地址寄存器]\\n不同处理器执行的同一条指令所处理的数据[F##不同]\",\n1755\t    \"answer\": \"\"\n1756\t  },\n1757\t  {\n1758\t    \"category\": \"计组\",\n1759\t    \"question\": \"SIMD在[F##使用for循环处理数组]时最有效\\n在[F##使用case或switch语句]时效率最低，此时每个执行单元[F##必须根据不同的数据执行不同的操作]\",\n1760\t    \"answer\": \"\"\n1761\t  },\n1762\t  {\n1763\t    \"category\": \"计组\",\n1764\t    \"question\": \"多指令多数据流（MIMD）结构分为[F##多计算机系统和多处理器系统]\",\n1765\t    \"answer\": \"\"\n1766\t  },\n1767\t  {\n1768\t    \"category\": \"计组\",\n1769\t    \"question\": \"MIMD多计算机系统也称[F##消息传递MIMD]\\n多处理器系统也称[F##共享存储MIMD]\",\n1770\t    \"answer\": \"\"\n1771\t  },\n1772\t  {\n1773\t    \"category\": \"计组\",\n1774\t    \"question\": \"向量处理器是[F##SIMD]的变体，是一种[F##实现了直接操作一维数组（向量）指令集]的CPU\",\n1775\t    \"answer\": \"\"\n1776\t  },\n1777\t  {\n1778\t    \"category\": \"计组\",\n1779\t    \"question\": \"SIMD是一种[F##数据级]并行模式\\nMIMD是一种[F##线程级或线程级以上并行计算模式]\",\n1780\t    \"answer\": \"\"\n1781\t  },\n1782\t  {\n1783\t    \"category\": \"计组\",\n1784\t    \"question\": \"在支持硬件多线程的CPU中，必须[F##为每个线程提供单独的通用寄存器组、单独的程序计数器等]\",\n1785\t    \"answer\": \"\"\n1786\t  },\n1787\t  {\n1788\t    \"category\": \"计组\",\n1789\t    \"question\": \"硬件多线程有三种实现方式：[F##细粒度多线程]、[F##粗粒度多线程]、[F##同时多线程（SMT）]\",\n1790\t    \"answer\": \"\"\n1791\t  },\n1792\t  {\n1793\t    \"category\": \"计组\",\n1794\t    \"question\": \"细粒度多线程是[F##多个线程之间轮流交叉执行指令]\\n处理器在[F##每个时钟周期]切换线程\",\n1795\t    \"answer\": \"\"\n1796\t  },\n1797\t  {\n1798\t    \"category\": \"计组\",\n1799\t    \"question\": \"粗粒度多线程是[F##仅在一个线程出现了较大开销的阻塞时才切换线程]\",\n1800\t    \"answer\": \"\"\n1801\t  },\n1802\t  {\n1803\t    \"category\": \"计组\",\n1804\t    \"question\": \"同时多线程是[F##在同一个时钟周期中，发射多个不同线程中的多条指令执行]\",\n1805\t    \"answer\": \"\"\n1806\t  },\n1807\t  {\n1808\t    \"category\": \"计组\",\n1809\t    \"question\": \"拥有共享的单一物理地址空间的多处理器被称为[F##共享内存多处理器（SMP）]\",\n1810\t    \"answer\": \"\"\n1811\t  },\n1812\t  {\n1813\t    \"category\": \"计组\",\n1814\t    \"question\": \"超线程技术的CPU需要[F##芯片组、OS和应用软件]的支持\",\n1815\t    \"answer\": \"\"\n1816\t  },\n1817\t  {\n1818\t    \"category\": \"计组\",\n1819\t    \"question\": \"超线程是[F##在一个单处理器或单个核中设置两套线程状态部件，共享高速缓存和功能部件]\",\n1820\t    \"answer\": \"\"\n1821\t  },\n1822\t  {\n1823\t    \"category\": \"计组\",\n1824\t    \"question\": \"统一存储访问（UMA）多处理器和非统一存储访问（NUMA）多处理器的区别是\\n前者[F##每个处理器对所有存储单元的访问时间大致相同，访存时间与哪个存储器提出访存请求以及访问哪个字无关]<br>\\n\\n后者[F##某些访存请求要比其他的快，具体取决于哪个处理器提出了访问请求以及访问哪个字]\",\n1825\t    \"answer\": \"\"\n1826\t  },\n1827\t  {\n1828\t    \"category\": \"计组\",\n1829\t    \"question\": \"NUMA访存时间不同的原因是[F##主存被分割并分配给了同一机器上的不同处理器或内存控制器]\",\n1830\t    \"answer\": \"\"\n1831\t  },\n1832\t  {\n1833\t    \"category\": \"计组\",\n1834\t    \"question\": \"总线特性是指[F##机械特性]、[F##电气特性]、[F##功能特性]、[F##时间特性]\",\n1835\t    \"answer\": \"\"\n1836\t  },\n1837\t  {\n1838\t    \"category\": \"计组\",\n1839\t    \"question\": \"总线按功能分为[F##片内总线]、[F##系统总线]、[F##IO总线]和[F##通信总线]\",\n1840\t    \"answer\": \"\"\n1841\t  },\n1842\t  {\n1843\t    \"category\": \"计组\",\n1844\t    \"question\": \"总线按时序控制方式分为[F##同步总线]和[F##异步总线]\",\n1845\t    \"answer\": \"\"\n1846\t  },\n1847\t  {\n1848\t    \"category\": \"计组\",\n1849\t    \"question\": \"总线按数据传输方式分为[F##并行总线和串行总线]\",\n1850\t    \"answer\": \"\"\n1851\t  },\n1852\t  {\n1853\t    \"category\": \"计组\",\n1854\t    \"question\": \"总线传输周期包括[F##申请]阶段、[F##寻址]阶段、[F##传输]阶段和[F##结束]阶段\",\n1855\t    \"answer\": \"\"\n1856\t  },\n1857\t  {\n1858\t    \"category\": \"计组\",\n1859\t    \"question\": \"总线带宽=[F##总线宽度x总线频率]\",\n1860\t    \"answer\": \"\"\n1861\t  },\n1862\t  {\n1863\t    \"category\": \"计组\",\n1864\t    \"question\": \"总线定时是[F##总线在双方交换数据的过程中需要时间上配合关系的控制]\",\n1865\t    \"answer\": \"\"\n1866\t  },\n1867\t  {\n1868\t    \"category\": \"计组\",\n1869\t    \"question\": \"总线事务是[F##从请求总线到完成总线使用的操作序列]\",\n1870\t    \"answer\": \"\"\n1871\t  },\n1872\t  {\n1873\t    \"category\": \"计组\",\n1874\t    \"question\": \"总线事务一般包括[F##请求阶段]、[F##仲裁阶段]、[F##寻址阶段]、[F##传输阶段]、[F##释放阶段]\",\n1875\t    \"answer\": \"\"\n1876\t  },\n1877\t  {\n1878\t    \"category\": \"计组\",\n1879\t    \"question\": \"总线同步定时方式是[F##系统采用一个统一的时钟信号来协调发送和接收双方的传送定时关系]\\n时钟产生[F##相等的]时间间隔，每个间隔[F##构成一个总线周期]\",\n1880\t    \"answer\": \"\"\n1881\t  },\n1882\t  {\n1883\t    \"category\": \"计组\",\n1884\t    \"question\": \"同步定时方式\\n优点是\\n\\n1.[F##传送速度快]\\n\\n2.[F##总线控制逻辑简单]\\n\\n缺点是\\n\\n1.[F##主从设备属于强制性同步]\\n\\n2.[F##不能及时进行数据通信的有效性检验,可靠性较差]\\n\\n适用于[F##总线长度较短及总线所接部件的存取时间比较接近的系统]\",\n1885\t    \"answer\": \"\"\n1886\t  },\n1887\t  {\n1888\t    \"category\": \"计组\",\n1889\t    \"question\": \"异步定时方式是[F##采用应答的方式，没有公共时钟标准]\\n优点是[F##总线周期长度可变，能保证速度相差很大的部件或设备之间可靠地进行信息交换，自动适应时间的配合]\\n\\n缺点是[F##复杂，比同步定时慢]\",\n1890\t    \"answer\": \"\"\n1891\t  },\n1892\t  {\n1893\t    \"category\": \"计组\",\n1894\t    \"question\": \"不互锁方式是[F##双方过段时间自动撤销信号]\",\n1895\t    \"answer\": \"\"\n1896\t  },\n1897\t  {\n1898\t    \"category\": \"计组\",\n1899\t    \"question\": \"半互锁方式是[F##主设备需要等从设备响应才撤销信号，从设备过段时间自动撤销信号]\",\n1900\t    \"answer\": \"\"\n1901\t  },\n1902\t  {\n1903\t    \"category\": \"计组\",\n1904\t    \"question\": \"全互锁方式是[F##双方撤销信号与否都要根据对方是否响应或撤销信号来决定]\",\n1905\t    \"answer\": \"\"\n1906\t  },\n1907\t  {\n1908\t    \"category\": \"计组\",\n1909\t    \"question\": \"异步定时方式\\n速度最快的是[F##不互锁方式]，最慢的是[F##全互锁方式]\\n\\n可靠性最好的是[F##全互锁方式]，最差的是[F##不互锁方式]\",\n1910\t    \"answer\": \"\"\n1911\t  },\n1912\t  {\n1913\t    \"category\": \"计组\",\n1914\t    \"question\": \"IO接口的主要功能有\\n1.进行[F##地址译码]和[F##设备]选择\\n\\n2.实现[F##主机和外设的通信联络控制]\\n\\n3.实现[F##数据缓冲]\\n\\n4.[F##信号格式]的转换\\n\\n5.传送[F##控制命令和状态信息]\\n\\n6.[F##错误或状态]检测\",\n1915\t    \"answer\": \"\"\n1916\t  },\n1917\t  {\n1918\t    \"category\": \"计组\",\n1919\t    \"question\": \"CPU对外设的控制命令通过[F##数据线]传送给IO接口\\n接口和设备的状态信息通过[F##数据线]传送给CPU\",\n1920\t    \"answer\": \"\"\n1921\t  },\n1922\t  {\n1923\t    \"category\": \"计组\",\n1924\t    \"question\": \"IO指令只能在[F##OS内核的底层IO软件中]使用\\n其是一种[F##特权指令]\",\n1925\t    \"answer\": \"\"\n1926\t  },\n1927\t  {\n1928\t    \"category\": \"计组\",\n1929\t    \"question\": \"IO端口是[F##接口电路中可被CPU直接访问的寄存器]\\n主要有[F##数据接口]、[F##状态接口]、[F##控制端口]\",\n1930\t    \"answer\": \"\"\n1931\t  },\n1932\t  {\n1933\t    \"category\": \"计组\",\n1934\t    \"question\": \"IO端口的编址方式有[F##统一编址（存储器映射）方式]和[F##独立编址（IO映射方式）]\",\n1935\t    \"answer\": \"\"\n1936\t  },\n1937\t  {\n1938\t    \"category\": \"计组\",\n1939\t    \"question\": \"IO端口统一编址的优点是[F##不需要设置专门的输入输出指令，可使CPU访问IO的操作更灵活、端口有较大的编址空间]\\n缺点是[F##端口占用存储器地址，使内存容量变小，而且利用存储器编址的IO设备进行输入输出操作执行速度较慢（地址译码速度慢）]\",\n1940\t    \"answer\": \"\"\n1941\t  },\n1942\t  {\n1943\t    \"category\": \"计组\",\n1944\t    \"question\": \"IO独立编址的优点是[F##输入输出指令与存储器指令有明显区别，程序编制清晰，便于理解]\\n缺点是[F##输入输出指令少，一般只能对端口进行传送操作。需要CPU提供存储器读写、IO设备读写两组控制信号，增加了控制的复杂性]\",\n1945\t    \"answer\": \"\"\n1946\t  },\n1947\t  {\n1948\t    \"category\": \"计组\",\n1949\t    \"question\": \"IO接口中控制寄存器和状态寄存器在传送方向上是[F##相反的]\\n在使用时间上是[F##错开的]\\n\\n所以二者可以合二为一\",\n1950\t    \"answer\": \"\"\n1951\t  },\n1952\t  {\n1953\t    \"category\": \"计组\",\n1954\t    \"question\": \"IO指令实现的数据传送通常发生在[F##通用寄存器和IO端口]之间\",\n1955\t    \"answer\": \"\"\n1956\t  },\n1957\t  {\n1958\t    \"category\": \"计组\",\n1959\t    \"question\": \"实现应用程序和操作系统（管态程序）的切换的功能称为[F##软中断]\",\n1960\t    \"answer\": \"\"\n1961\t  },\n1962\t  {\n1963\t    \"category\": \"计组\",\n1964\t    \"question\": \"IO程序查询方式，CPU一旦启动IO，就必须[F##停止现行程序，并在现行程序中插入一段程序]\",\n1965\t    \"answer\": \"\"\n1966\t  },\n1967\t  {\n1968\t    \"category\": \"计组\",\n1969\t    \"question\": \"IO程序查询方式的主要特点是[F##CPU有“踏步”等待现象，CPU与IO串行工作]\\n优点是[F##接口设计简单，设备量少]\\n\\n缺点是[F##CPU在信息传送过程中要花费很多时间来查询和等待，而且一段时间内只能和一台外设交换信息，效率低]\",\n1970\t    \"answer\": \"\"\n1971\t  },\n1972\t  {\n1973\t    \"category\": \"计组\",\n1974\t    \"question\": \"通过[F##INTR线]发出的是可屏蔽中断\\n通过[F##NMI线]发出的是不可屏蔽中断\",\n1975\t    \"answer\": \"\"\n1976\t  },\n1977\t  {\n1978\t    \"category\": \"计组\",\n1979\t    \"question\": \"在关中断模式下会被响应的是[F##不可屏蔽中断和内部异常]\",\n1980\t    \"answer\": \"\"\n1981\t  },\n1982\t  {\n1983\t    \"category\": \"计组\",\n1984\t    \"question\": \"中断响应的判优通常是通过[F##硬件排队器]实现的\",\n1985\t    \"answer\": \"也可以用软件实现\"\n1986\t  },\n1987\t  {\n1988\t    \"category\": \"计组\",\n1989\t    \"question\": \"中断响应的优先级一般是\\n[F##不可屏蔽中断]>[F##内部异常]>[F##可屏蔽中断]\",\n1990\t    \"answer\": \"\"\n1991\t  },\n1992\t  {\n1993\t    \"category\": \"计组\",\n1994\t    \"question\": \"内部异常中，优先级\\n硬件故障[F##>]软件中断\",\n1995\t    \"answer\": \"\"\n1996\t  },\n1997\t  {\n1998\t    \"category\": \"计组\",\n1999\t    \"question\": \"DMA中断请求[F##优先于]IO设备传送的中断请求\",\n2000\t    \"answer\": \"\"\n2001\t  },\n2002\t  {\n2003\t    \"category\": \"计组\",\n2004\t    \"question\": \"IO传送类中断请求中\\n高速设备[F##优先于]低速设备\\n\\n输入设备[F##优先于]输出设备\\n\\n实时设备[F##优先于]普通设备\",\n2005\t    \"answer\": \"\"\n2006\t  },\n2007\t  {\n2008\t    \"category\": \"计组\",\n2009\t    \"question\": \"CPU响应中断必须满足的条件有\\n1.[F##中断源有中断请求]<br>\\n\\n2.[F##CPU允许中断及开中断（异常和不可屏蔽中断不受此限制）]<br>\\n\\n3.[F##一条指令执行完毕（异常不受此影响）]\",\n2010\t    \"answer\": \"\"\n2011\t  },\n2012\t  {\n2013\t    \"category\": \"计组\",\n2014\t    \"question\": \"中断隐指令完成的操作有\\n1.[F##关中断]<br>\\n\\n2.[F##保存断点（可和1同时完成）]\\n\\n3.[F##引出中断服务程序]\",\n2015\t    \"answer\": \"\"\n2016\t  },\n2017\t  {\n2018\t    \"category\": \"计组\",\n2019\t    \"question\": \"中断识别分为[F##向量中断]和[F##非向量中断（软件查询法）]\",\n2020\t    \"answer\": \"\"\n2021\t  },\n2022\t  {\n2023\t    \"category\": \"计组\",\n2024\t    \"question\": \"中断向量是[F##中断类型号对应的中断服务程序的入口地址]\",\n2025\t    \"answer\": \"\"\n2026\t  },\n2027\t  {\n2028\t    \"category\": \"计组\",\n2029\t    \"question\": \"中断处理流程是\\n1.[F##关中断]\\n\\n2.[F##保存断点]\\n\\n3.[F##中断服务程序寻址]\\n\\n4.[F##保存现场和屏蔽字]\\n\\n5.[F##开中断（可实现中断嵌套）]\\n\\n6.[F##执行中断服务程序]\\n\\n7.[F##关中断]\\n\\n8.[F##恢复现场和屏蔽字]\\n\\n9.[F##开中断，中断返回]\\n\\n其中[F##1～3]由中断隐指令（硬件自动）完成，[F##4～9]由中断服务程序完成\",\n2030\t    \"answer\": \"\"\n2031\t  },\n2032\t  {\n2033\t    \"category\": \"计组\",\n2034\t    \"question\": \"每个中断源对应一个屏蔽字（在处理该中断源的中断服务程序时，屏蔽字寄存器中的内容为该中断源对应的屏蔽字）\\n屏蔽字中[F##“1”]越多优先级越高\",\n2035\t    \"answer\": \"每个屏蔽字中至少有一个“1”，至少能屏蔽自身的中断\"\n2036\t  },\n2037\t  {\n2038\t    \"category\": \"计组\",\n2039\t    \"question\": \"DMA模式下，IO与主机[F##并行工作]，程序和传送[F##并行工作]\",\n2040\t    \"answer\": \"\"\n2041\t  },\n2042\t  {\n2043\t    \"category\": \"计组\",\n2044\t    \"question\": \"DMA模式的特点是\\n1.他使主存[F##与CPU的固定关系脱钩，CPU和外设都能访问主存]\\n\\n2.数据块传送时，主存地址的确定、传送数据的计数等都由[F##硬件电路直接]实现\\n\\n3.主存中要[F##开辟专用缓冲区，及时供给和接收外设的数据]\\n\\n4.CPU和外设[F##并行工作]\\n\\n5.DMA在传送开始前要[F##通过程序进行预处理]，结束后要[F##通过中断方式进行后处理]\",\n2045\t    \"answer\": \"\"\n2046\t  },\n2047\t  {\n2048\t    \"category\": \"计组\",\n2049\t    \"question\": \"DMA控制器的组成有\\n1.[F##主存地址计数器（AR）]\\n\\n2.[F##传送长度计数器（WC）]\\n3.[F##数据缓冲寄存器]\\n\\n\\n4.[F##DMA请求触发器]<br>\\n\\n5.[F##“控制/状态”逻辑]<br>\\n\\n6.[F##中断机构]<br>\",\n2050\t    \"answer\": \"\"\n2051\t  },\n2052\t  {\n2053\t    \"category\": \"计组\",\n2054\t    \"question\": \"DMA传送过程中，DMA控制器将接管CPU的[F##地址总线、数据总线和控制总线]\\nCPU的主存控制信号[F##被禁止使用]\",\n2055\t    \"answer\": \"\"\n2056\t  },\n2057\t  {\n2058\t    \"category\": \"计组\",\n2059\t    \"question\": \"DMA控制器与CPU使用主存的方式有\\n1.[F##停止CPU访存]\\n\\n2.[F##周期挪用（周期窃取）]\\n\\n3.[F##DMA与CPU交替访存（适用于CPU工作周期比主存存储周期长的情况，一个CPU周期分为两个周期，一个DMA访存一个CPU访存）]\",\n2060\t    \"answer\": \"\"\n2061\t  },\n2062\t  {\n2063\t    \"category\": \"计组\",\n2064\t    \"question\": \"DMA与CPU交替访存[F##不需要]总线使用权的申请、建立和归还\",\n2065\t    \"answer\": \"\"\n2066\t  },\n2067\t  {\n2068\t    \"category\": \"计组\",\n2069\t    \"question\": \"DMA数据传送的过程分为[F##预处理]、[F##数据传送]和[F##后处理]三个阶段\",\n2070\t    \"answer\": \"\"\n2071\t  },\n2072\t  {\n2073\t    \"category\": \"计组\",\n2074\t    \"question\": \"IO访存的优先级[F##高于]CPU访存\",\n2075\t    \"answer\": \"\"\n2076\t  },\n2077\t  {\n2078\t    \"category\": \"计组\",\n2079\t    \"question\": \"CPU对DMA请求的响应发生在[F##任意一个机器周期/总线周期结束时]\",\n2080\t    \"answer\": \"\"\n2081\t  },\n2082\t  {\n2083\t    \"category\": \"计组\",\n2084\t    \"question\": \"DMA请求的优先级[F##高于]中断请求\",\n2085\t    \"answer\": \"\"\n2086\t  },\n2087\t  {\n2088\t    \"category\": \"计组\",\n2089\t    \"question\": \"数据传送，中断方式靠[F##程序]传送，DMA方式靠[F##硬件]传送\",\n2090\t    \"answer\": \"\"\n2091\t  },\n2092\t  {\n2093\t    \"category\": \"计组\",\n2094\t    \"question\": \"中断方式具有[F##处理异常事件]的能力\",\n2095\t    \"answer\": \"\"\n2096\t  },\n2097\t  {\n2098\t    \"category\": \"计组\",\n2099\t    \"question\": \"中断优先级的高低顺序依次为：[F##硬件故障中断]<strong>、</strong>[F##自愿（访管）中断]<strong>、</strong>[F##程序性中断]<strong>，</strong>[F##外部中断]<strong>和</strong>[F##输入输出中断]\",\n2100\t    \"answer\": \"\"\n2101\t  },\n2102\t  {\n2103\t    \"category\": \"计组\",\n2104\t    \"question\": \"DMA传送方式中，由[F##外设]发出DMA请求\",\n2105\t    \"answer\": \"\"\n2106\t  },\n2107\t  {\n2108\t    \"category\": \"计组\",\n2109\t    \"question\": \"DMA传送前由[F##设备驱动程序]设置传送参数\",\n2110\t    \"answer\": \"\"\n2111\t  },\n2112\t  {\n2113\t    \"category\": \"计组\",\n2114\t    \"question\": \"DMA周期挪用时DMA[F##传送完一个数据后立即]释放总线\",\n2115\t    \"answer\": \"\"\n2116\t  },\n2117\t  {\n2118\t    \"category\": \"计组\",\n2119\t    \"question\": \"DMA方式下，主存和IO设备之间[F##没有]物理通路相连\",\n2120\t    \"answer\": \"\"\n2121\t  },\n2122\t  {\n2123\t    \"category\": \"计组\",\n2124\t    \"question\": \"非规格化浮点数数\\n阶码真实值=[F##1-偏置值]\\n\\n隐藏位[F##等于0]\",\n2125\t    \"answer\": \"\"\n2126\t  },\n2127\t  {\n2128\t    \"category\": \"计组\",\n2129\t    \"question\": \"IEEE标准浮点数运算\\n[F##满足]交换律<br>\\n\\n[F##不满足]结合律<br>\",\n2130\t    \"answer\": \"\"\n2131\t  }\n2132\t]"
