            "result": "1\t[\n2\t  {\n3\t    \"category\": \"ds\",\n4\t    \"question\": \"结构类型和抽象数据类型的区别是什么\",\n5\t    \"answer\": \"结构数据类型是结构体的定义\\n抽象数据类型是数据结构的定义，定义了数据的组织方式、数据对象和基本操作\"\n6\t  },\n7\t  {\n8\t    \"category\": \"ds\",\n9\t    \"question\": \"时间复杂度的排序\\nO(1)<[F##O(\\\\(\\\\log_2n\\\\))]<O(n)<[F##O(\\\\(n\\\\log_2n\\\\))]<O(\\\\(n^2\\\\))<O(\\\\(n^3\\\\))<[F##O(\\\\(2^n\\\\))]<[F##O(n!)]<O(\\\\(n^n\\\\))\",\n10\t    \"answer\": \"\"\n11\t  },\n12\t  {\n13\t    \"category\": \"ds\",\n14\t    \"question\": \"顺序表插入操作的时间复杂度最好为[F##O(1)],最坏为[F##O(n)],平均为[F##O(n)]\",\n15\t    \"answer\": \"\"\n16\t  },\n17\t  {\n18\t    \"category\": \"ds\",\n19\t    \"question\": \"链表的前插如何实现？\",\n20\t    \"answer\": \"所有的前插都能转化为后插，后插完后交换两者数据即可\"\n21\t  },\n22\t  {\n23\t    \"category\": \"ds\",\n24\t    \"question\": \"链表如何删除给定节点*p\",\n25\t    \"answer\": \"将后继节点的值赋予*p，后删除后继节点，时间复杂度可达O(1)，但p只能为非尾节点，否则仍需遍历\"\n26\t  },\n27\t  {\n28\t    \"category\": \"ds\",\n29\t    \"question\": \"共享栈如何判断栈满？\",\n30\t    \"answer\": \"top1-top0=1\"\n31\t  },\n32\t  {\n33\t    \"category\": \"ds\",\n34\t    \"question\": \"循环队列长度为：[F##(Q.rear+Maxsize-Q.front)%Maxsize]\",\n35\t    \"answer\": \"\"\n36\t  },\n37\t  {\n38\t    \"category\": \"ds\",\n39\t    \"question\": \"用栈计算后缀表达式\\n先[F##从左往右]扫描\\n\\n若该项是[F##操作数]则压入栈中\\n\\n若该项是[F##操作符]则[F##从栈中推出两个操作数进行运算]\\n\\n先出栈的是[F##右操作数]\\n\\n计算结果要[F##压回栈中]\",\n40\t    \"answer\": \"\"\n41\t  },\n42\t  {\n43\t    \"category\": \"ds\",\n44\t    \"question\": \"n阶对称矩阵A存放在一维数组B[[F##\\\\(\\\\frac{n(n+1)}{2}\\\\)]]中\",\n45\t    \"answer\": \"\"\n46\t  },\n47\t  {\n48\t    \"category\": \"ds\",\n49\t    \"question\": \"对称矩阵元素\\\\(a_{ij}\\\\)的数组下标的映射（数组下标从0开始）\\n\\\\[\\n\\n&nbsp; K=\\\\begin{cases}\\n\\n&nbsp; [F##\\\\frac{i(i-1)}{2}+j-1] &nbsp; &i \\\\ge j(下三角区和主对角线元素) \\\\\\\\\\n\\n&nbsp; [F##\\\\frac{j(j-1)}{2}+i-1] &nbsp; &i<j (上三角区元素) \\\\\\\\\\n\\n\\\\end{cases}\\\\]\",\n50\t    \"answer\": \"注意行号列号是从1开始的\"\n51\t  },\n52\t  {\n53\t    \"category\": \"ds\",\n54\t    \"question\": \"n阶下三角矩阵A存储在一维数组B[[F##\\\\(\\\\frac{n(n+1)}{2}+1\\\\)]]中\",\n55\t    \"answer\": \"比对称矩阵多一个元素，用于存其上三角区的常量\"\n56\t  },\n57\t  {\n58\t    \"category\": \"ds\",\n59\t    \"question\": \"下三角矩阵元素\\\\(a_{ij}\\\\)与数组下标的对应关系为\\n\\\\[&nbsp;\\n\\n&nbsp;K=\\n\\n&nbsp;\\\\begin{cases}\\n\\n&nbsp; [F##\\\\frac{i(i-1)}{2}+j-1] &nbsp; &nbsp;& i \\\\ge j(下三角区和主对角线元素) \\\\\\\\\\n\\n&nbsp; [F##\\\\frac{n(n+1)}{2} ] &nbsp; &nbsp; &nbsp; &nbsp;& i<j &nbsp;(上三角区元素)&nbsp;\\n\\n&nbsp;\\\\end{cases} &nbsp;&nbsp;\\n\\n\\\\]<br>\",\n60\t    \"answer\": \"\"\n61\t  },\n62\t  {\n63\t    \"category\": \"ds\",\n64\t    \"question\": \"上三角矩阵元素\\\\(a_{ij}\\\\)与数组下标的对应关系为\\n\\\\[\\n\\nK=\\\\begin{cases}\\n\\n&nbsp;[F##\\\\frac{(i-1)(2n-i+2)}{2}+(j-i)] &nbsp; &nbsp;&i\\\\le j(上三角区和主对角线元素)\\\\\\\\\\n\\n&nbsp;[F##\\\\frac{n(n+1)}{2} ] &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&i>j(下三角区元素)\\n\\n\\\\end{cases}\\n\\n\\\\]<br>\",\n65\t    \"answer\": \"\"\n66\t  },\n67\t  {\n68\t    \"category\": \"ds\",\n69\t    \"question\": \"三对角矩阵元素\\\\(a_{ij}\\\\)与数组下标的对应关系为k=[F##2i+j-3]\\n反之，若已知元素存放于B[k]，则i=[F##\\\\(\\\\lfloor\\\\frac{k+1}{3}+1\\\\rfloor\\\\)],j=[F##k-2i+3]\",\n70\t    \"answer\": \"\"\n71\t  },\n72\t  {\n73\t    \"category\": \"ds\",\n74\t    \"question\": \"串的存储结构有\\n[F##定长顺序]存储<br>\\n\\n[F##堆分配]存储<br>\\n\\n[F##块链]存储<br>\\n\\n三种\",\n75\t    \"answer\": \"\"\n76\t  },\n77\t  {\n78\t    \"category\": \"ds\",\n79\t    \"question\": \"串的堆分配存储中，字符序列的存储单元地址是[F##连续的]\",\n80\t    \"answer\": \"\"\n81\t  },\n82\t  {\n83\t    \"category\": \"ds\",\n84\t    \"question\": \"串的堆分配存储和定长顺序存储的不同之处是[F##堆分配的存储空间是动态分配的]\",\n85\t    \"answer\": \"\"\n86\t  },\n87\t  {\n88\t    \"category\": \"ds\",\n89\t    \"question\": \"块链存储若最后一个结点占不满时通常用[F##“#”]补上\",\n90\t    \"answer\": \"\"\n91\t  },\n92\t  {\n93\t    \"category\": \"ds\",\n94\t    \"question\": \"简单模式匹配算法的最坏时间复杂度是[F##O(mn)]\",\n95\t    \"answer\": \"\"\n96\t  },\n97\t  {\n98\t    \"category\": \"ds\",\n99\t    \"question\": \"KMP的时间复杂度是[F##O(m+n)]\",\n100\t    \"answer\": \"\"\n101\t  },\n102\t  {\n103\t    \"category\": \"ds\",\n104\t    \"question\": \"KMP的主要优点是[F##主串不回溯]\",\n105\t    \"answer\": \"\"\n106\t  },\n107\t  {\n108\t    \"category\": \"ds\",\n109\t    \"question\": \"KMP中，求next数组的时间复杂度是[F##O(n)]\\n模式匹配过程最坏时间复杂度是[F##O(m)]\",\n110\t    \"answer\": \"\"\n111\t  },\n112\t  {\n113\t    \"category\": \"ds\",\n114\t    \"question\": \"手算next数组时，next[1]=[F##0],next[2]=[F##1]\",\n115\t    \"answer\": \"无脑填\"\n116\t  },\n117\t  {\n118\t    \"category\": \"ds\",\n119\t    \"question\": \"KMP的优化，是讲next[j]修正为next[[F##next[j]]]，直至字符串中下标对应的两者不相等为止,更新后的数组命名为nextval\",\n120\t    \"answer\": \"手算时，先求next再有next求出nextval\"\n121\t  },\n122\t  {\n123\t    \"category\": \"ds\",\n124\t    \"question\": \"手工求next数组的方法是模式串的[F##前缀]和模式串当前位置起前一个算的[F##后缀]的最大相等长度+1\",\n125\t    \"answer\": \"\"\n126\t  },\n127\t  {\n128\t    \"category\": \"ds\",\n129\t    \"question\": \"结点的度是[F##该结点的孩子个数]\\n树的度是[F##树中结点的最大度数]\",\n130\t    \"answer\": \"\"\n131\t  },\n132\t  {\n133\t    \"category\": \"ds\",\n134\t    \"question\": \"节点的深度是[F##从根结点开始自顶向下组层累加的]\",\n135\t    \"answer\": \"\"\n136\t  },\n137\t  {\n138\t    \"category\": \"ds\",\n139\t    \"question\": \"结点的高度是[F##叶结点开始自底向上逐层累加的]\",\n140\t    \"answer\": \"\"\n141\t  },\n142\t  {\n143\t    \"category\": \"ds\",\n144\t    \"question\": \"树的高度或深度是[F##树中结点的最大层数]\",\n145\t    \"answer\": \"\"\n146\t  },\n147\t  {\n148\t    \"category\": \"ds\",\n149\t    \"question\": \"树的路径长度是[F##路径上所经过的边的个数]\",\n150\t    \"answer\": \"\"\n151\t  },\n152\t  {\n153\t    \"category\": \"ds\",\n154\t    \"question\": \"树中的结点数=[F##所有结点的度数之和加1]\",\n155\t    \"answer\": \"\"\n156\t  },\n157\t  {\n158\t    \"category\": \"ds\",\n159\t    \"question\": \"度为m的树中第i层上至多有[F##\\\\(m^{i-1}\\\\)]个结点）\\\\(i\\\\geq 1\\\\)\",\n160\t    \"answer\": \"\"\n161\t  },\n162\t  {\n163\t    \"category\": \"ds\",\n164\t    \"question\": \"高度为h的m叉树至多有[F##\\\\(\\\\frac{m^h-1}{m-1}\\\\)]个结点\",\n165\t    \"answer\": \"等比求和推导\"\n166\t  },\n167\t  {\n168\t    \"category\": \"ds\",\n169\t    \"question\": \"具有n个结点的m叉树的最小高度为[F##\\\\(\\\\lceil{\\\\log_m(n(m-1)+1)} \\\\rceil\\\\)]\",\n170\t    \"answer\": \"\"\n171\t  },\n172\t  {\n173\t    \"category\": \"ds\",\n174\t    \"question\": \"高度为h的m叉树至少有[F##h]个结点\",\n175\t    \"answer\": \"\"\n176\t  },\n177\t  {\n178\t    \"category\": \"ds\",\n179\t    \"question\": \"高度为h的度为m的树至少有[F##h+m-1]个结点\",\n180\t    \"answer\": \"\"\n181\t  },\n182\t  {\n183\t    \"category\": \"ds\",\n184\t    \"question\": \"高度为h的完全m叉树，结点个数n的范围是[F##\\\\(\\\\frac{m^{h-1}-1}{m-1}<n\\\\leq\\\\frac{m^{h}-1}{m-1}\\\\)]\",\n185\t    \"answer\": \"\"\n186\t  },\n187\t  {\n188\t    \"category\": \"ds\",\n189\t    \"question\": \"树的路径长度是从树根到每个结点的路径长度的[F##总和]\",\n190\t    \"answer\": \"\"\n191\t  },\n192\t  {\n193\t    \"category\": \"ds\",\n194\t    \"question\": \"二叉树是[F##有序]树\",\n195\t    \"answer\": \"\"\n196\t  },\n197\t  {\n198\t    \"category\": \"ds\",\n199\t    \"question\": \"二叉树与度为2的有序树的区别\\n1.度为2的树至少有3个结点，而二叉树[F##可以为空]\\n\\n2.有序树的孩子的左右次序是[F##相对的]，二叉树的孩子的左右次序是[F##绝对的]\",\n200\t    \"answer\": \"\"\n201\t  },\n202\t  {\n203\t    \"category\": \"ds\",\n204\t    \"question\": \"高度为h的满二叉树有[F##\\\\(2^h-1\\\\)]个结点\",\n205\t    \"answer\": \"\"\n206\t  },\n207\t  {\n208\t    \"category\": \"ds\",\n209\t    \"question\": \"满二叉树的特点是[F##只有最后一层有]叶子结点、[F##不存在]度为1的结点、可以[F##按层序编号]\",\n210\t    \"answer\": \"\"\n211\t  },\n212\t  {\n213\t    \"category\": \"ds\",\n214\t    \"question\": \"满二叉树按层序编号（根结点编号为1）\\n对编号为i的结点\\n\\n其双亲（若有）为[F##\\\\(\\\\lfloor\\\\frac{i}{2}\\\\rfloor\\\\)]\\n\\n其左孩子为[F##2i]，右孩子为[F##2i+1]\",\n215\t    \"answer\": \"可以用于顺序存储\"\n216\t  },\n217\t  {\n218\t    \"category\": \"ds\",\n219\t    \"question\": \"对于n个结点的完全二叉树的分支结点是否都有左右孩子，\\n若n为奇数，则[F##每个分支结点都有左右孩子]\\n\\n若n为偶数，则[F##编号最大的分支结点（n/2）只有左孩子]\",\n220\t    \"answer\": \"\"\n221\t  },\n222\t  {\n223\t    \"category\": \"ds\",\n224\t    \"question\": \"平衡二叉树，树上任意一个结点的左子树和右子树的深度之差[F##不超过1]\",\n225\t    \"answer\": \"\"\n226\t  },\n227\t  {\n228\t    \"category\": \"ds\",\n229\t    \"question\": \"非空二叉树上叶结点数=[F##度为2的结点数加1，即\\\\(n_0=n_2+1\\\\)]\",\n230\t    \"answer\": \"\"\n231\t  },\n232\t  {\n233\t    \"category\": \"ds\",\n234\t    \"question\": \"对任意一棵树，若结点的数量为n，则边的数量为[F##n-1]\",\n235\t    \"answer\": \"\"\n236\t  },\n237\t  {\n238\t    \"category\": \"ds\",\n239\t    \"question\": \"非空二叉树上第k层至多有[F##\\\\(2^{k-1}\\\\)]个结点\",\n240\t    \"answer\": \"\"\n241\t  },\n242\t  {\n243\t    \"category\": \"ds\",\n244\t    \"question\": \"高度为h的完全二叉树至多有[F##\\\\(2^h-1\\\\)]个结点\\n至少有[F##\\\\(2^{h-1}\\\\)]个结点\",\n245\t    \"answer\": \"\"\n246\t  },\n247\t  {\n248\t    \"category\": \"ds\",\n249\t    \"question\": \"对完全二叉树，结点i所在的层次（深度）为[F##\\\\(\\\\lfloor\\\\log_2i\\\\rfloor+1\\\\)]\",\n250\t    \"answer\": \"\"\n251\t  },\n252\t  {\n253\t    \"category\": \"ds\",\n254\t    \"question\": \"具有n个结点的完全二叉树的高度为[F##\\\\(\\\\lceil\\\\log_2(n+1)\\\\rceil\\\\)]或[F##\\\\(\\\\lfloor\\\\log_2n\\\\rfloor+1\\\\)]\",\n255\t    \"answer\": \"\"\n256\t  },\n257\t  {\n258\t    \"category\": \"ds\",\n259\t    \"question\": \"高度为h的完全二叉树的定义有\\n[F##\\\\(2^{h-1}-1\\\\)]<n\\\\(\\\\leq\\\\)[F##\\\\(2^h-1\\\\)]<br>\\n\\n或\\n\\n[F##\\\\(2^{h-1}\\\\)]\\\\(\\\\leq\\\\)n<[F##\\\\(2^h\\\\)]<font face=\\\"-apple-system\\\" size=\\\"3\\\"><br></font>\",\n260\t    \"answer\": \"\"\n261\t  },\n262\t  {\n263\t    \"category\": \"ds\",\n264\t    \"question\": \"对完全二叉树可由n推出度为0、1、2度结点个数为\\\\(n_0,n_1,n_2\\\\)\\n若有2k个结点，则必有\\\\(n_1\\\\)=[F##1],\\\\(n_0\\\\)=[F##k],\\\\(n_2\\\\)=[F##k-1]\\n\\n\\n\\n\\n若有2k-1个结点，则必有\\\\(n_1\\\\)=[F##0],\\\\(n_0\\\\)=[F##k],\\\\(n_2\\\\)=[F##k-1]\",\n265\t    \"answer\": \"\\\\(n_0+n_2\\\\)一定是奇数\\n\\\\(n_0=n_2+1\\\\)\"\n266\t  },\n267\t  {\n268\t    \"category\": \"ds\",\n269\t    \"question\": \"完全二叉树和满二叉树适合采用[F##顺序]存储\",\n270\t    \"answer\": \"\"\n271\t  },\n272\t  {\n273\t    \"category\": \"ds\",\n274\t    \"question\": \"顺序存储二叉树时建议数组下标[F##从1开始]\",\n275\t    \"answer\": \"为了与结点编号对应\"\n276\t  },\n277\t  {\n278\t    \"category\": \"ds\",\n279\t    \"question\": \"含有n个结点的二叉链表中，含有[F##n+1]个空链域\\n共有[F##2n]个指针域\",\n280\t    \"answer\": \"\"\n281\t  },\n282\t  {\n283\t    \"category\": \"ds\",\n284\t    \"question\": \"一棵完全二叉树，第n层有叶子结点，其高度为[F##n或n+1]\",\n285\t    \"answer\": \"\"\n286\t  },\n287\t  {\n288\t    \"category\": \"ds\",\n289\t    \"question\": \"求树的深度的递归代码步骤如下\\n若二叉树为空，则返回0，否则\\n\\n1.获取左子树深度l\\n\\n2.获取右子树深度r\\n\\n3.[F##return l>r? l+1:r+1]\",\n290\t    \"answer\": \"\"\n291\t  },\n292\t  {\n293\t    \"category\": \"ds\",\n294\t    \"question\": \"二叉树的递归遍历算法\\n时间复杂度都是[F##O(n)]\\n\\n空间复杂度都是[F##O(n)]\\n\\n递归工作栈的栈深为[F##树的深度]\",\n295\t    \"answer\": \"\"\n296\t  },\n297\t  {\n298\t    \"category\": \"ds\",\n299\t    \"question\": \"非递归的中序遍历的步骤是\\n1.沿着根的左孩子，[F##依次入栈]，直到左孩子为空\\n\\n2.栈顶元素出栈并访问，若[F##其右孩子为空]，继续执行2\\n\\n3.若[F##其右孩子不空]，将右子树转执行1\\n\\n非递归的先序遍历只要[F##把访问结点的操作放在入栈操作前面]\",\n300\t    \"answer\": \"\"\n301\t  },\n302\t  {\n303\t    \"category\": \"ds\",\n304\t    \"question\": \"二叉树后续非递归遍历的步骤是\\n1.从根结点开始，将其入栈，然后沿其左子树一直往下搜索，直到[F##搜索到没有左孩子的结点]\\n\\n2.如果其有右子树，则[F##按照相同的规则对其右子树进行处理]\\n\\n3.直至上述操作进行不下去，出栈访问。\",\n305\t    \"answer\": \"\"\n306\t  },\n307\t  {\n308\t    \"category\": \"ds\",\n309\t    \"question\": \"二叉树层次遍历的步骤是\\n1.将二叉树根结点入队然后出队访问\\n\\n2.[F##将当前访问结点的左右孩子入队]\\n\\n3.队头结点出栈访问，并重复2直至队列为空\",\n310\t    \"answer\": \"\"\n311\t  },\n312\t  {\n313\t    \"category\": \"ds\",\n314\t    \"question\": \"由遍历序列构造二叉树，必须要有[F##中序序列]\",\n315\t    \"answer\": \"\"\n316\t  },\n317\t  {\n318\t    \"category\": \"ds\",\n319\t    \"question\": \"线索二叉树是为了能[F##加快查找结点前驱或后继的速度]\\n其结点若无左子树，则[F##lchild指向其前驱结点]\\n\\n若无右子树，则[F##令rchild指向其后继结点]\\n\\n此外还需增设两标志位ltag和rtag\\n\\n标志位为0表示[F##指针指向左/右孩子]\\n\\n标志位为1表示[F##指针指向前驱/后继]\",\n320\t    \"answer\": \"\"\n321\t  },\n322\t  {\n323\t    \"category\": \"ds\",\n324\t    \"question\": \"线索链表是[F##线索二叉树的存储结构]\\n其中指向结点前驱和后继的指针称为[F##线索]\",\n325\t    \"answer\": \"\"\n326\t  },\n327\t  {\n328\t    \"category\": \"ds\",\n329\t    \"question\": \"二叉树的线索化是[F##将二叉链表中的空指针改为指向前驱或后继的线索]\\n其实质是[F##遍历一次二叉树]\",\n330\t    \"answer\": \"\"\n331\t  },\n332\t  {\n333\t    \"category\": \"ds\",\n334\t    \"question\": \"构建中序线索二叉树的核心思想是\\n[F##增设pre指向刚刚访问过的结点]<br>\\n\\n指针p指向正在访问的结点\\n\\n在中序遍历的过程中检查p的左指针是否为空\\n\\n若为空，则[F##将其指向pre]\\n\\n检查pre的右指针是否为空\\n\\n若为空，则[F##将其指向p]\\n\\n<br>\",\n335\t    \"answer\": \"\"\n336\t  },\n337\t  {\n338\t    \"category\": \"ds\",\n339\t    \"question\": \"中序遍历找后继，若其右标志为1，则其后继是[F##右孩子]\\n否则其后继是[F##右子树中第一个被访问的结点]\",\n340\t    \"answer\": \"\"\n341\t  },\n342\t  {\n343\t    \"category\": \"ds\",\n344\t    \"question\": \"先序线索二叉树找后继\\n若有左孩子，则[F##左孩子就是其后继]\\n\\n若无左孩子但有右孩子，则[F##右孩子就是其后继]\\n\\n如果为叶结点，则[F##右孩子指向其后继]\",\n345\t    \"answer\": \"\"\n346\t  },\n347\t  {\n348\t    \"category\": \"ds\",\n349\t    \"question\": \"后序线索二叉树找后继\\n1.若结点x是二叉树的根，则[F##其后继为空]\\n\\n2.若结点x是其双亲的右孩子或是其双亲的左孩子且其双亲没有右子树，则[F##其后继即为双亲]\\n\\n3.若结点x是其双亲的左孩子，且其双亲有右子树，则[F##其后继为双亲的右子树上按后序遍历列出的第一个结点]\",\n350\t    \"answer\": \"\"\n351\t  },\n352\t  {\n353\t    \"category\": \"ds\",\n354\t    \"question\": \"线索二叉树是一种[F##物理]结构\",\n355\t    \"answer\": \"\"\n356\t  },\n357\t  {\n358\t    \"category\": \"ds\",\n359\t    \"question\": \"[F##后序]线索树的遍历仍需要栈的支持<br>\",\n360\t    \"answer\": \"\"\n361\t  },\n362\t  {\n363\t    \"category\": \"ds\",\n364\t    \"question\": \"二叉树在线索化后仍不能有效求解的问题是[F##后序线索二叉树求后序后继]\",\n365\t    \"answer\": \"\"\n366\t  },\n367\t  {\n368\t    \"category\": \"ds\",\n369\t    \"question\": \"邻接矩阵法存储带权图\\n\\\\[\\n\\nA[i][j]=\\n\\n\\\\begin{cases}\\n\\n[F##w_{ij}&nbsp;], &nbsp; &nbsp; &nbsp;& 若 (v_i,v_j)或<v_i,v_j>是图中的边 \\\\\\\\ &nbsp;&nbsp;\\n\\n[F##\\\\infty或0], &nbsp; &nbsp; &nbsp; &若(v_i,v_j)或<v_i,v_j>不是图中的边&nbsp;\\n\\n\\\\end{cases}\\n\\n\\n\\\\]<br>\\n\\n对于无权图，只需把\\\\(w_{ij}\\\\)改为[F##1]，\\\\(\\\\infty\\\\)改为[F##0]\\n\\n无权无向图的邻接矩阵是[F##对称矩阵]\",\n370\t    \"answer\": \"\"\n371\t  },\n372\t  {\n373\t    \"category\": \"ds\",\n374\t    \"question\": \"对于有向图的邻接矩阵\\n第i行非0元素的个数是顶点i的[F##出度]\\n\\n第i列非0元素的个数是顶点i的[F##入度]\",\n375\t    \"answer\": \"\"\n376\t  },\n377\t  {\n378\t    \"category\": \"ds\",\n379\t    \"question\": \"prim算法构造最小生成树的策略是\\n初始时任取一个顶点加入集合T\\n\\n每次选择[F##一个与当前T中顶点集合最近的顶点]\\n\\n并将该点和相应的边加入T\\n\\n直到所有的顶点都加入T\\n\\nT中必然有[F##n-1]条边\",\n380\t    \"answer\": \"\"\n381\t  },\n382\t  {\n383\t    \"category\": \"ds\",\n384\t    \"question\": \"prim算法的时间复杂度为[F##O(|\\\\(V^2\\\\)|)]\\n其适用于求解[F##边稠密的图]的最小生成树\",\n385\t    \"answer\": \"\"\n386\t  },\n387\t  {\n388\t    \"category\": \"ds\",\n389\t    \"question\": \"最小生成树的性质有\\n1.最小生成树不唯一，当[F##图中各边权值互不相等]时，图的最小生成树是唯一的\\n\\n2.最小生成树的边的权值之和[F##总是唯一]\\n\\n3.最小生成树的边数为[F##顶点数减1]\",\n390\t    \"answer\": \"\"\n391\t  },\n392\t  {\n393\t    \"category\": \"ds\",\n394\t    \"question\": \"Kruskal（克鲁斯卡尔）算法求最小生成树的方法是\\n每次[F##选择未选过的权值最小的且不会造成回路的边]\",\n395\t    \"answer\": \"\"\n396\t  },\n397\t  {\n398\t    \"category\": \"ds\",\n399\t    \"question\": \"kruskal使用[F##并查集]来查找两个顶点是否属于不同连通分量\",\n400\t    \"answer\": \"处于不同连通分量即边加入后不会产生回路\"\n401\t  },\n402\t  {\n403\t    \"category\": \"ds\",\n404\t    \"question\": \"kruskal算法采用[F##堆]来存放边的集合\",\n405\t    \"answer\": \"\"\n406\t  },\n407\t  {\n408\t    \"category\": \"ds\",\n409\t    \"question\": \"kruskal算法的时间复杂度是[F##O(\\\\(|E|\\\\log_2|E|\\\\))]\\n因此，其适用于[F##边稀疏而顶点较多的]图\",\n410\t    \"answer\": \"\"\n411\t  },\n412\t  {\n413\t    \"category\": \"ds\",\n414\t    \"question\": \"散列表的查找效率取决于三个因素：[F##散列函数]，[F##处理冲突的办法]，和[F##装填因子]\",\n415\t    \"answer\": \"\"\n416\t  },\n417\t  {\n418\t    \"category\": \"ds\",\n419\t    \"question\": \"散列表的装填因子一般计为\\\\(\\\\alpha\\\\),定义为[F##一个表的装满程度]\\n即\\\\(\\\\alpha\\\\)=[F##\\\\(\\\\frac{表中记录数n}{散列表长度m}\\\\)]\",\n420\t    \"answer\": \"\"\n421\t  },\n422\t  {\n423\t    \"category\": \"ds\",\n424\t    \"question\": \"散列处理冲突的方法有[F##开放定址法]和[F##拉链法]\\n开放定址法又分[F##线性探测法]、[F##平方探测法]、[F##双散列法（再散列法）]和[F##伪随机序列法]\",\n425\t    \"answer\": \"\"\n426\t  },\n427\t  {\n428\t    \"category\": \"ds\",\n429\t    \"question\": \"开放定址法是指可存放新表项的空闲地址既[F##向它的同义词表项开放]，又[F##向它的非同义词表项开放]\\n拉链法是指[F##把所有同义词存储在一个线性链表中]\\n\\n拉链法适用于[F##经常进行插入和删除的情况]\",\n430\t    \"answer\": \"\"\n431\t  },\n432\t  {\n433\t    \"category\": \"ds\",\n434\t    \"question\": \"开放定址的情况下不能随便物理删除表中已有的元素，因为[F##若删除元素则会截断其他具有相同散列地址的元素的查找地址]\\n因此，要删除元素只能[F##增加一个删除标记，做逻辑删除]\\n\\n这样做的副作用是[F##执行多次删除后，散列表表面上看起来很满但实际上有许多位置未利用]\\n\\n因此需要定期维护散列表，要把删除标记的元素物理删除\",\n435\t    \"answer\": \"\"\n436\t  },\n437\t  {\n438\t    \"category\": \"ds\",\n439\t    \"question\": \"线性探测法处理冲突的特点是：冲突发生时[F##顺序查看表中的下一个单元，直到找出一个空闲单元，或查遍全表]\",\n440\t    \"answer\": \"\"\n441\t  },\n442\t  {\n443\t    \"category\": \"ds\",\n444\t    \"question\": \"线性探测法的缺点是[F##会造成大量元素在相邻散列地址上聚集起来，大大降低了查找效率]\",\n445\t    \"answer\": \"\"\n446\t  },\n447\t  {\n448\t    \"category\": \"ds\",\n449\t    \"question\": \"处理冲突的平方探测法是让增量序列=[F##\\\\(0^2,1^2,-1^2,2^2,-2^2,…,k^2,-k^2\\\\)]\\n其中k[F##\\\\(\\\\leq\\\\frac{m}{2}\\\\)]\\n\\n散列表长度m必须是一个[F##可以表示成4k+3的素数（才能探测到所有位置）]\",\n450\t    \"answer\": \"平方探测法又称二次探测法\"\n451\t  },\n452\t  {\n453\t    \"category\": \"ds\",\n454\t    \"question\": \"平方探测法的优点是[F##可以避免出现堆积问题]\\n缺点是[F##不能探测到散列表上的所有单元，但至少能探测到一半的单元]\",\n455\t    \"answer\": \"\"\n456\t  },\n457\t  {\n458\t    \"category\": \"ds\",\n459\t    \"question\": \"双/再散列法是指[F##使用两个/多个散列函数]\",\n460\t    \"answer\": \"\"\n461\t  },\n462\t  {\n463\t    \"category\": \"ds\",\n464\t    \"question\": \"散列冲突处理的随机序列法是指[F##增量序列为伪随机数序列]\",\n465\t    \"answer\": \"\"\n466\t  },\n467\t  {\n468\t    \"category\": \"ds\",\n469\t    \"question\": \"合并两个长度分别为m和n的有序表最坏情况下需要比较[F##m+n-1]次\\n最好情况下需要比较[F##n]次\",\n470\t    \"answer\": \"最坏情况是交叉\\n最好情况是一个表的最大比另一个表的最小小\"\n471\t  },\n472\t  {\n473\t    \"category\": \"ds\",\n474\t    \"question\": \"判断某种编码是否具有前缀特性（是否是哈夫曼编码）的方法是[F##用该编码集构建一颗哈夫曼树，如果成功构建则具有]\",\n475\t    \"answer\": \"\"\n476\t  },\n477\t  {\n478\t    \"category\": \"ds\",\n479\t    \"question\": \"散列表查找失败的asl的计算方法是[F##计算每个第一次可以取到的散列地址的查找失败的情况]\",\n480\t    \"answer\": \"如散列函数mod7，就计算0～6位置查找失败的情况\\n查找失败是查到空格或表尾结束\"\n481\t  },\n482\t  {\n483\t    \"category\": \"ds\",\n484\t    \"question\": \"用代码判定一个树是否是完全二叉树的方法是[F##层序遍历，将所有结点加入队列，遇到空结点时看其后是否有非空结点，若有则不是完全二叉树]\",\n485\t    \"answer\": \"\"\n486\t  },\n487\t  {\n488\t    \"category\": \"ds\",\n489\t    \"question\": \"二叉树的后序非递归遍历，当访问到某结点时，栈中的所有元素均为[F##该结点的祖先]\",\n490\t    \"answer\": \"可用来求祖先或两个结点的公共祖先\"\n491\t  },\n492\t  {\n493\t    \"category\": \"ds\",\n494\t    \"question\": \"树的存储结构有[F##双亲]表示法，[F##孩子]表示法，[F##孩子兄弟]表示法\",\n495\t    \"answer\": \"\"\n496\t  },\n497\t  {\n498\t    \"category\": \"ds\",\n499\t    \"question\": \"双亲表示法采用[F##一组连续的空间]来存储每个结点\\n同时在每个结点中[F##增设一个伪指针，指示其双亲结点在数组中的位置]\",\n500\t    \"answer\": \"简单来说就是结构体数组存储\"\n501\t  },\n502\t  {\n503\t    \"category\": \"ds\",\n504\t    \"question\": \"双亲表示法的优点是[F##可以很快的得到每个结点的双亲结点]\\n缺点是[F##求结点的孩子时需要遍历整个结构]\",\n505\t    \"answer\": \"\"\n506\t  },\n507\t  {\n508\t    \"category\": \"ds\",\n509\t    \"question\": \"孩子表示法是[F##将每个结点的孩子结点都用单链表连接起来形成一个线性结构]\\n用一个[F##数组（链表也行，数组更方便）]存储所有结点\\n\\n每个结点都有一个链表存储[F##孩子结点所在的下标]\",\n510\t    \"answer\": \"\"\n511\t  },\n512\t  {\n513\t    \"category\": \"ds\",\n514\t    \"question\": \"孩子表示法的优点是[F##寻找子女的操作很方便]\\n缺点是[F##寻找双亲需要遍历n个结点中孩子链表指针域所指向的n个孩子链表]\",\n515\t    \"answer\": \"\"\n516\t  },\n517\t  {\n518\t    \"category\": \"ds\",\n519\t    \"question\": \"孩子兄弟表示法又称[F##二叉树表示法]\\n其每个结点包括三部分内容：\\n\\n1.[F##结点值]\\n\\n2.[F##指向结点第一个孩子的指针]\\n\\n3.[F##指向结点下一个兄弟结点的指针（沿此域可找到结点的所有兄弟结点）]\",\n520\t    \"answer\": \"\"\n521\t  },\n522\t  {\n523\t    \"category\": \"ds\",\n524\t    \"question\": \"孩子兄弟表示法的优点是[F##可以方便地实现树转换为二叉树的操作]、[F##易于查找结点的孩子]等\\n缺点是[F##从当前结点查找其双亲比较麻烦]\\n\\n解决方法是[F##为每个结点增设一个parent域指向其父结点]\",\n525\t    \"answer\": \"\"\n526\t  },\n527\t  {\n528\t    \"category\": \"ds\",\n529\t    \"question\": \"树转换为二叉树的规则就是孩子兄弟表示法的规则\\n简称[F##左孩子右兄弟]\",\n530\t    \"answer\": \"\"\n531\t  },\n532\t  {\n533\t    \"category\": \"ds\",\n534\t    \"question\": \"森林转换成二叉树的方法\\n1.将森林中的每棵树[F##转换成相应的二叉树]\\n\\n2.每棵树的[F##根视为兄弟关系，合并成一颗二叉树]\",\n535\t    \"answer\": \"\"\n536\t  },\n537\t  {\n538\t    \"category\": \"ds\",\n539\t    \"question\": \"二叉树转换为森林的方法[F##从根结点开始将右链的每个结点分离作为树的根]\",\n540\t    \"answer\": \"\"\n541\t  },\n542\t  {\n543\t    \"category\": \"ds\",\n544\t    \"question\": \"树的先根遍历的遍历序列与这棵树相应二叉树的[F##先序序列]相同\",\n545\t    \"answer\": \"\"\n546\t  },\n547\t  {\n548\t    \"category\": \"ds\",\n549\t    \"question\": \"树的后根遍历与这棵树相应二叉树的[F##中序序列]相同\",\n550\t    \"answer\": \"\"\n551\t  },\n552\t  {\n553\t    \"category\": \"ds\",\n554\t    \"question\": \"树的中根遍历与这棵树相应二叉树的[F##后序]序列相同\",\n555\t    \"answer\": \"\"\n556\t  },\n557\t  {\n558\t    \"category\": \"ds\",\n559\t    \"question\": \"森林的先序和中序遍历即为其对应二叉树的[F##先序和中序遍历]\",\n560\t    \"answer\": \"\"\n561\t  },\n562\t  {\n563\t    \"category\": \"ds\",\n564\t    \"question\": \"设F是一个森林，B是由F转换来的二叉树。\\n若F中有n个非终端结点，则B中右指针域为空的结点有[F##n+1]个\",\n565\t    \"answer\": \"\"\n566\t  },\n567\t  {\n568\t    \"category\": \"ds\",\n569\t    \"question\": \"将森林F转换为对应的二叉树T，F中叶结点的个数等于[F##T中左孩子指针为空的结点个数]\",\n570\t    \"answer\": \"\"\n571\t  },\n572\t  {\n573\t    \"category\": \"ds\",\n574\t    \"question\": \"树的带权路径长度WPL=[F##\\\\(\\\\sum_{i=1}^nw_il_i\\\\)]\",\n575\t    \"answer\": \"\"\n576\t  },\n577\t  {\n578\t    \"category\": \"ds\",\n579\t    \"question\": \"结点的带权路径长度是[F##从树根到该结点的路径长度与结点权值的乘积]\",\n580\t    \"answer\": \"\"\n581\t  },\n582\t  {\n583\t    \"category\": \"ds\",\n584\t    \"question\": \"哈夫曼树[F##不]唯一\\n哈夫曼树的WPL[F##唯一且最优]\",\n585\t    \"answer\": \"\"\n586\t  },\n587\t  {\n588\t    \"category\": \"ds\",\n589\t    \"question\": \"并查集用[F##互不相交的树]来表示多个集合\",\n590\t    \"answer\": \"\"\n591\t  },\n592\t  {\n593\t    \"category\": \"ds\",\n594\t    \"question\": \"并查集的find优化：先找到根结点，再将[F##查找路径上的所有结点都挂到根结点下]\\n压缩路径可使树高不超过[F##O（\\\\(\\\\alpha(n)\\\\)）]\",\n595\t    \"answer\": \"\"\n596\t  },\n597\t  {\n598\t    \"category\": \"ds\",\n599\t    \"question\": \"并查集的union优化：\\n1.用根结点的[F##绝对值]表示树的结点总数\\n\\n2.union操作让[F##小树]合并到[F##大树]\\n\\n构造出的树高不超过[F##\\\\(\\\\lfloor\\\\log_2n\\\\rfloor+1\\\\)]\",\n600\t    \"answer\": \"\"\n601\t  },\n602\t  {\n603\t    \"category\": \"ds\",\n604\t    \"question\": \"并查集union操作的时间复杂度是[F##O（1）]\",\n605\t    \"answer\": \"\"\n606\t  },\n607\t  {\n608\t    \"category\": \"ds\",\n609\t    \"question\": \"并查集find操作的最坏时间复杂度为[F##O（n）]\\n经过union优化后的时间复杂度是[F##\\\\(O(\\\\log_2n)\\\\)]\\n\\n再经过find优化后的时间复杂度是[F##\\\\(O(\\\\alpha n)\\\\)]\",\n610\t    \"answer\": \"\"\n611\t  },\n612\t  {\n613\t    \"category\": \"ds\",\n614\t    \"question\": \"n个独立元素通过多次合并成一个集合的时间复杂度是[F##O\\\\((n^2)\\\\)]\\n经过union优化后的时间复杂度是[F##\\\\(O(n\\\\log_2n)\\\\)]\\n\\n再经过find优化后的时间复杂度是[F##O(n\\\\(\\\\alpha n\\\\))]\",\n615\t    \"answer\": \"\"\n616\t  },\n617\t  {\n618\t    \"category\": \"ds\",\n619\t    \"question\": \"并查集的结构是一种[F##双亲表示法存储的树]\",\n620\t    \"answer\": \"\"\n621\t  },\n622\t  {\n623\t    \"category\": \"ds\",\n624\t    \"question\": \"并查集判断图的连通性的方法：\\n1.遍历图的边，每遍历到一条边就把这条边连接的两个顶点[F##合并到一个同集合中]\\n\\n2.遍历完所有边后，判断[F##是否所有点都在一个集合中]\",\n625\t    \"answer\": \"\"\n626\t  },\n627\t  {\n628\t    \"category\": \"ds\",\n629\t    \"question\": \"对有n个顶点的有向图\\n所有顶点的出度之和=[F##所有顶点的入度之和]=[F##｜E｜]\",\n630\t    \"answer\": \"\"\n631\t  },\n632\t  {\n633\t    \"category\": \"ds\",\n634\t    \"question\": \"对有n个顶点的有向图\\n所有顶点的度之和=[F##2｜E｜]\",\n635\t    \"answer\": \"\"\n636\t  },\n637\t  {\n638\t    \"category\": \"ds\",\n639\t    \"question\": \"若G是强连通图则至少有[F##n]条边\",\n640\t    \"answer\": \"形成回路\"\n641\t  },\n642\t  {\n643\t    \"category\": \"ds\",\n644\t    \"question\": \"有向完全图共有[F##\\\\(2C_n^2\\\\)]条边\",\n645\t    \"answer\": \"\"\n646\t  },\n647\t  {\n648\t    \"category\": \"ds\",\n649\t    \"question\": \"对于n个顶点的无向图G\\n所有顶点的度之和=[F##2|E|]\",\n650\t    \"answer\": \"\"\n651\t  },\n652\t  {\n653\t    \"category\": \"ds\",\n654\t    \"question\": \"对于n个顶点的无向图G\\n若G是连通图，则最少有[F##n-1]条边\",\n655\t    \"answer\": \"树的形状\"\n656\t  },\n657\t  {\n658\t    \"category\": \"ds\",\n659\t    \"question\": \"对于n个顶点的无向图G\\n若｜E｜>n-1，则[F##一定有回路]\",\n660\t    \"answer\": \"\"\n661\t  },\n662\t  {\n663\t    \"category\": \"ds\",\n664\t    \"question\": \"对于n个顶点的无向图G\\n若G是非连通图，则最多可能有[F##\\\\(C_{n-1}^2\\\\)]条边\",\n665\t    \"answer\": \"<br>\\nn-1个顶点的完全图+一个孤立顶点\"\n666\t  },\n667\t  {\n668\t    \"category\": \"ds\",\n669\t    \"question\": \"无向完全图共有[F##\\\\(C_n^2\\\\)]条边\",\n670\t    \"answer\": \"\"\n671\t  },\n672\t  {\n673\t    \"category\": \"ds\",\n674\t    \"question\": \"简单图的定义是\\n1.不存在[F##重复边]\\n\\n2.不存在[F##顶点到自身的边]\",\n675\t    \"answer\": \"数据结构仅讨论简单图\"\n676\t  },\n677\t  {\n678\t    \"category\": \"ds\",\n679\t    \"question\": \"完全图有[F##\\\\(\\\\frac{n(n-1)}{2}\\\\)]条边\",\n680\t    \"answer\": \"任意两个顶点间都存在边\\n完全图是无向图\"\n681\t  },\n682\t  {\n683\t    \"category\": \"ds\",\n684\t    \"question\": \"有向完全图有[F##\\\\(n(n-1)\\\\)]条边\",\n685\t    \"answer\": \"\"\n686\t  },\n687\t  {\n688\t    \"category\": \"ds\",\n689\t    \"question\": \"有向完全图中任意两个顶点之间都存在[F##方向相反的边]\",\n690\t    \"answer\": \"\"\n691\t  },\n692\t  {\n693\t    \"category\": \"ds\",\n694\t    \"question\": \"生成子图相比于原图的变化是[F##顶点相同，边集是原图的子集]\",\n695\t    \"answer\": \"<br>\\n顶点不变，边删减\"\n696\t  },\n697\t  {\n698\t    \"category\": \"ds\",\n699\t    \"question\": \"若G中[F##任意两个顶点都是连通的]，则称G为连通图\",\n700\t    \"answer\": \"\"\n701\t  },\n702\t  {\n703\t    \"category\": \"ds\",\n704\t    \"question\": \"无向图的极大连通子图称为[F##连通分量]\",\n705\t    \"answer\": \"\"\n706\t  },\n707\t  {\n708\t    \"category\": \"ds\",\n709\t    \"question\": \"极大连通子图是[F##连通的包含尽可能多的边和顶点的子图]\",\n710\t    \"answer\": \"\"\n711\t  },\n712\t  {\n713\t    \"category\": \"ds\",\n714\t    \"question\": \"有向图中，若一对顶点[F##相互连通]，则称这两个顶点是强连通的\",\n715\t    \"answer\": \"\"\n716\t  },\n717\t  {\n718\t    \"category\": \"ds\",\n719\t    \"question\": \"强连通图的要求是[F##图中任意一对顶点都是强连通的]\",\n720\t    \"answer\": \"\"\n721\t  },\n722\t  {\n723\t    \"category\": \"ds\",\n724\t    \"question\": \"有向图中的极大强连通子图称为有向图的[F##强连通分量]\",\n725\t    \"answer\": \"\"\n726\t  },\n727\t  {\n728\t    \"category\": \"ds\",\n729\t    \"question\": \"连通图的生成树是[F##包含图中全部顶点的一个极小连通子图]\",\n730\t    \"answer\": \"树不存在回路\"\n731\t  },\n732\t  {\n733\t    \"category\": \"ds\",\n734\t    \"question\": \"极小连通子图是[F##既要保持图连通又要使得边数最少]的子图\",\n735\t    \"answer\": \"\"\n736\t  },\n737\t  {\n738\t    \"category\": \"ds\",\n739\t    \"question\": \"一般当图满足[F##\\\\(|E|<|V|\\\\log|V|\\\\)]时，可以视作稀疏图\",\n740\t    \"answer\": \"\"\n741\t  },\n742\t  {\n743\t    \"category\": \"ds\",\n744\t    \"question\": \"[F##顶点不重复出现的]路径/回路称为简单路径/回路<br>\",\n745\t    \"answer\": \"\"\n746\t  },\n747\t  {\n748\t    \"category\": \"ds\",\n749\t    \"question\": \"V和E的任何子集[F##不一定]能构成G的子图\",\n750\t    \"answer\": \"有可能构成的不是图，如有的边关联的点不在子图的点集中\"\n751\t  },\n752\t  {\n753\t    \"category\": \"ds\",\n754\t    \"question\": \"存在回路的图[F##不存在]拓扑序列\",\n755\t    \"answer\": \"\"\n756\t  },\n757\t  {\n758\t    \"category\": \"ds\",\n759\t    \"question\": \"设图G的邻接矩阵为A\\n\\\\(A^n的元素A^n[i][j]\\\\)=[F##由顶点i到顶点j的长度为n的路径的数目]\",\n760\t    \"answer\": \"\"\n761\t  },\n762\t  {\n763\t    \"category\": \"ds\",\n764\t    \"question\": \"邻接表法对于有向图来说边表中存储的是[F##该顶点的出边]\",\n765\t    \"answer\": \"\"\n766\t  },\n767\t  {\n768\t    \"category\": \"ds\",\n769\t    \"question\": \"图的邻接表存储\\n若G为无向图，则所需的存储空间为[F##O(|V|+2|E|)],删除顶点边的时间复杂度[F##高]\\n\\n若G为有向图，则所需的存储空间为[F##O(|V|+|E|)]\",\n770\t    \"answer\": \"\"\n771\t  },\n772\t  {\n773\t    \"category\": \"ds\",\n774\t    \"question\": \"邻接表若要确定给定顶点间是否存在边，效率[F##较低]\",\n775\t    \"answer\": \"\"\n776\t  },\n777\t  {\n778\t    \"category\": \"ds\",\n779\t    \"question\": \"在有向图的邻接表表示中\\n求一个给定顶点的出度需要[F##计算其邻接表中的结点个数]\\n\\n求其顶点的入度需要[F##遍历全部邻接表]\",\n780\t    \"answer\": \"\"\n781\t  },\n782\t  {\n783\t    \"category\": \"ds\",\n784\t    \"question\": \"图的邻接表表示[F##不]唯一\",\n785\t    \"answer\": \"\"\n786\t  },\n787\t  {\n788\t    \"category\": \"ds\",\n789\t    \"question\": \"十字链表存有向图的空间复杂度是[F##O(|V|+|E|)]\",\n790\t    \"answer\": \"\"\n791\t  },\n792\t  {\n793\t    \"category\": \"ds\",\n794\t    \"question\": \"十字链表中，有向图的每一个结点对应一个[F##顶点结点]\\n每条弧对应一个[F##弧结点]\",\n795\t    \"answer\": \"\"\n796\t  },\n797\t  {\n798\t    \"category\": \"ds\",\n799\t    \"question\": \"十字链表中弧结点的构成是\\n1.[F##弧尾顶点编号]\\n\\n2.[F##弧头顶点编号]\\n\\n3.[F##指向弧头相同的下一条弧的指针]\\n\\n4.[F##指向弧尾相同的下一条弧的指针]\\n5.[F##权值]\",\n800\t    \"answer\": \"\"\n801\t  },\n802\t  {\n803\t    \"category\": \"ds\",\n804\t    \"question\": \"十字链表中\\n弧头相同的弧在[F##同一个链表上]\\n\\n弧尾相同的弧在[F##同一个链表上]\",\n805\t    \"answer\": \"\"\n806\t  },\n807\t  {\n808\t    \"category\": \"ds\",\n809\t    \"question\": \"十字链表中，顶点结点的构成是\\n1.[F##顶点信息]\\n\\n2.[F##指向以该顶点为弧头的第一个弧结点的指针]\\n\\n3.[F##指向以该顶点为弧尾的第一个弧结点的指针]\",\n810\t    \"answer\": \"\"\n811\t  },\n812\t  {\n813\t    \"category\": \"ds\",\n814\t    \"question\": \"十字链表的优点是[F##容易求得顶点的出度和入度]\",\n815\t    \"answer\": \"\"\n816\t  },\n817\t  {\n818\t    \"category\": \"ds\",\n819\t    \"question\": \"邻接多重表是用来存储[F##无向图的]\",\n820\t    \"answer\": \"\"\n821\t  },\n822\t  {\n823\t    \"category\": \"ds\",\n824\t    \"question\": \"邻接多重表的边结点构成是\\n1.[F##一个顶点的编号]\\n\\n2.[F##另一个顶点的编号]\\n\\n3.[F##指向下一条依附于1中顶点的边的指针]\\n\\n4.[F##指向下一条依附于2中顶点的边的指针]\\n\\n5.[F##该边的相关信息]\",\n825\t    \"answer\": \"\"\n826\t  },\n827\t  {\n828\t    \"category\": \"ds\",\n829\t    \"question\": \"邻接多重表中顶点结点的构成是\\n1.[F##顶点相关信息]\\n\\n2.[F##指向第一条依附于该顶点的边]\",\n830\t    \"answer\": \"\"\n831\t  },\n832\t  {\n833\t    \"category\": \"ds\",\n834\t    \"question\": \"BFS类似二叉树的[F##层序遍历]\\n需要借助一个[F##辅助队列来保存下一层结点]\",\n835\t    \"answer\": \"\"\n836\t  },\n837\t  {\n838\t    \"category\": \"ds\",\n839\t    \"question\": \"图的遍历需要设[F##一个辅助数组visited[]来标记顶点是否被访问过]\",\n840\t    \"answer\": \"顶点一背访问就将对应元素置为true\"\n841\t  },\n842\t  {\n843\t    \"category\": \"ds\",\n844\t    \"question\": \"BFS可用于[F##最优解问题]\",\n845\t    \"answer\": \"\"\n846\t  },\n847\t  {\n848\t    \"category\": \"ds\",\n849\t    \"question\": \"最坏情况下，BFS的空间复杂度为[F##O(|V|)]\",\n850\t    \"answer\": \"\"\n851\t  },\n852\t  {\n853\t    \"category\": \"ds\",\n854\t    \"question\": \"邻接表存储时，BFS的时间复杂度是[F##O(|V|+|E|)]\\n邻接矩阵存储时，BFS的时间复杂度是[F##O\\\\((|V|^2)\\\\)]\",\n855\t    \"answer\": \"\"\n856\t  },\n857\t  {\n858\t    \"category\": \"ds\",\n859\t    \"question\": \"BFS可以求解[F##非带权图]的单源最短路径问题\",\n860\t    \"answer\": \"\"\n861\t  },\n862\t  {\n863\t    \"category\": \"ds\",\n864\t    \"question\": \"对图进行遍历时记得要[F##遍历所有连通分量]\",\n865\t    \"answer\": \"\"\n866\t  },\n867\t  {\n868\t    \"category\": \"ds\",\n869\t    \"question\": \"BFS可以获得一颗遍历树，称为[F##广度优先生成树]\\n对于非连通图可以得到[F##广度优先森林]\",\n870\t    \"answer\": \"\"\n871\t  },\n872\t  {\n873\t    \"category\": \"ds\",\n874\t    \"question\": \"邻接矩阵存储的广度优先生成树是[F##唯一的]\\n邻接表存储的广度优先生成树是[F##不唯一的]\",\n875\t    \"answer\": \"因为邻接矩阵唯一，邻接表不唯一\"\n876\t  },\n877\t  {\n878\t    \"category\": \"ds\",\n879\t    \"question\": \"深度优先搜索类似树的[F##先序遍历]\",\n880\t    \"answer\": \"\"\n881\t  },\n882\t  {\n883\t    \"category\": \"ds\",\n884\t    \"question\": \"对同一个图\\n基于邻接矩阵遍历所得到的DFS和BFS序列[F##唯一]\\n\\n基于邻接表遍历所得到的DFS和BFS序列[F##不唯一]\",\n885\t    \"answer\": \"\"\n886\t  },\n887\t  {\n888\t    \"category\": \"ds\",\n889\t    \"question\": \"DFS是[F##递归的]\\nBFS是[F##非递归的]\",\n890\t    \"answer\": \"\"\n891\t  },\n892\t  {\n893\t    \"category\": \"ds\",\n894\t    \"question\": \"最坏情况下DFS的空间复杂度是[F##O(|V|)]\",\n895\t    \"answer\": \"\"\n896\t  },\n897\t  {\n898\t    \"category\": \"ds\",\n899\t    \"question\": \"邻接矩阵表示时，DFS的时间复杂度是[F##O(\\\\(|V|^2\\\\))]\\n邻接表存储时，DFS的时间复杂度是[F##O(|V|+|E|)]\",\n900\t    \"answer\": \"\"\n901\t  },\n902\t  {\n903\t    \"category\": \"ds\",\n904\t    \"question\": \"对连通图调用DFS能产生[F##深度优先生成树]\",\n905\t    \"answer\": \"\"\n906\t  },\n907\t  {\n908\t    \"category\": \"ds\",\n909\t    \"question\": \"调用BFS和DFS的次数等于[F##该图的连通分量数]\",\n910\t    \"answer\": \"\"\n911\t  },\n912\t  {\n913\t    \"category\": \"ds\",\n914\t    \"question\": \"带权有向图的最短路径问题\\n单源最短路径可通过[F##Dijkstra]算法求解\\n\\n求每对顶点间的最短路径可通过[F##Floyd]算法来求解\",\n915\t    \"answer\": \"\"\n916\t  },\n917\t  {\n918\t    \"category\": \"ds\",\n919\t    \"question\": \"Dijkstra算法适用于[F##无权图和带权图]\\n但[F##边上存在负权值]时不适用\",\n920\t    \"answer\": \"\"\n921\t  },\n922\t  {\n923\t    \"category\": \"ds\",\n924\t    \"question\": \"Dijkstra算法的辅助数组的作用分别是\\nfinal[]：[F##用于标记各结点是否已找到最短路径]\\n\\nDist[]:[F##用于记录从源点v0到其他各顶点当前的最短路径长度]，它的初态为[F##若v0到vi有弧，则dist[i]为弧上的权值，否则为\\\\(\\\\infty\\\\)]\\n\\nPath[]:[F##path[i]表示从源点到顶点i之间的最短路径的前驱结点]\",\n925\t    \"answer\": \"\"\n926\t  },\n927\t  {\n928\t    \"category\": \"ds\",\n929\t    \"question\": \"Dijkstra算法的步骤如下（不考虑对path[]的操作）\\n1.初始化：集合S初始为{0},dist[]的初值dist[i]=[F##arcs[0][i]],i=1,2,…,n-1\\n\\n2.从顶点集合V-S中选出\\\\(v_j\\\\),满足dist[j]=Min{dist[i] |\\\\(v_i\\\\in V-S, v_j\\\\)}就是当前求得的一条[F##从v0出发的最短路径的终点]，将vj加入集合S\\n\\n3.修改从v0出发到集合V-S上任意一个顶点\\\\(v_k\\\\)可达的最短路径长度：[F##若dist[j]+arcs[j][k]<dist[k],则更新dist[k]=dist[j]+arcs[j][k]]\\n\\n4.重复2和3操作共n-1次，直到所有顶点都包含在S中\",\n930\t    \"answer\": \"\"\n931\t  },\n932\t  {\n933\t    \"category\": \"ds\",\n934\t    \"question\": \"Dijkstra算法的时间复杂度是[F##O(\\\\(|V|^2\\\\))]\",\n935\t    \"answer\": \"邻接矩阵和邻接表都是\"\n936\t  },\n937\t  {\n938\t    \"category\": \"ds\",\n939\t    \"question\": \"Floyd算法的步骤的文字描述如下\\n1.初始时，对于两个顶点\\\\(v_i和v_j\\\\),若他们之间存在边，则[F##以此边上的权值作为他们之间的最短路径长度]\\n\\n若他们之间不存在有向边，则[F##以\\\\(\\\\infty\\\\)作为它们之间的最短路径长度]\\n\\n2.以后逐步尝试[F##在原路径中加入顶点k（k=0,1,2,…,n-1）作为中间结点]\\n\\n若增加中间结点后，得到的路径比原来的路径长度减小了，则以此路径代替原路径\",\n940\t    \"answer\": \"\"\n941\t  },\n942\t  {\n943\t    \"category\": \"ds\",\n944\t    \"question\": \"Floyd的算法描述如下\\n定义一个n阶方阵序列\\\\(A^{-1},A^{0},…,A^{n-1}\\\\),其中\\n\\n\\\\(A^{-1}[i][j]=\\\\)[F##arcs[i][j]]\\n\\n\\\\(A^{k}[i][j]=\\\\)[F##\\\\(Min\\\\{A^{k-1}[i][j],A^{k-1}[i][k]+A^{k-1}[k][j]\\\\}\\\\) ], k=0,1,…,n-1\",\n945\t    \"answer\": \"\"\n946\t  },\n947\t  {\n948\t    \"category\": \"ds\",\n949\t    \"question\": \"Floyd的算法执行过程如下\\n1.初始化：方阵\\\\(A^{-1}[i][j]=\\\\)[F##arcs[i][j]]\\n\\n2.第k轮：将\\\\(v_k\\\\)作为中间结点，对于所有顶点对{i,j}\\n\\n如果有[F##\\\\(A^{k-1}[i][j]>A^{k-1}[i][k]+A^{-1}[k][j]\\\\)]\\n\\n则将\\\\(A^{-1}[i][j]\\\\)更新为[F##\\\\(A^{k-1}[i][k]+A^{-1}[k][j]\\\\)]\\n\\nK=0,1,…,n-1,更新后的方阵标记为\\\\(A^k\\\\)\",\n950\t    \"answer\": \"\"\n951\t  },\n952\t  {\n953\t    \"category\": \"ds\",\n954\t    \"question\": \"Floyd算法的时间复杂度是[F##\\\\(O(|V|^3)\\\\)]\",\n955\t    \"answer\": \"\"\n956\t  },\n957\t  {\n958\t    \"category\": \"ds\",\n959\t    \"question\": \"Floyd算法允许[F##图中带有负权值的边]\\n但不允许[F##有包含带负权值的边组成的回路]\",\n960\t    \"answer\": \"\"\n961\t  },\n962\t  {\n963\t    \"category\": \"ds\",\n964\t    \"question\": \"若一个有向图中不存在环，则称为[F##有向无环图]，简称[F##DAG图]\",\n965\t    \"answer\": \"\"\n966\t  },\n967\t  {\n968\t    \"category\": \"ds\",\n969\t    \"question\": \"若用DAG图表示一个工程，其顶点表示活动，用有向边<\\\\(V_i,V_j\\\\)>表示活动\\\\(V_i\\\\)必须先于活动\\\\(V_j\\\\)进行的这样一种关系\\n则将这种有向图称为[F##顶点表示活动的网络]，记为[F##AOV网]\",\n970\t    \"answer\": \"\"\n971\t  },\n972\t  {\n973\t    \"category\": \"ds\",\n974\t    \"question\": \"拓扑排序是对[F##DAG图的顶点]的一种排序\\n它使得若存在一条从顶点A到顶点B的路径\\n\\n则在排序中[F##B出现在顶点A的后面]\",\n975\t    \"answer\": \"\"\n976\t  },\n977\t  {\n978\t    \"category\": \"ds\",\n979\t    \"question\": \"每个AOV网都有[F##一个或多个]拓扑排序序列\",\n980\t    \"answer\": \"\"\n981\t  },\n982\t  {\n983\t    \"category\": \"ds\",\n984\t    \"question\": \"拓扑排序的步骤\\n1.从AOV网中选择[F##一个没有前驱的顶点]并输出\\n\\n2.从网中[F##删除该顶点和所有以它为起点的有向边]\\n\\n3.重复1和2直到当前AOV网为空或当前网中不存在无前驱的顶点为止\\n\\n后一种情况说明[F##有向图中必然存在环]\",\n985\t    \"answer\": \"\"\n986\t  },\n987\t  {\n988\t    \"category\": \"ds\",\n989\t    \"question\": \"DFS可用于实现[F##拓扑排序]\",\n990\t    \"answer\": \"\"\n991\t  },\n992\t  {\n993\t    \"category\": \"ds\",\n994\t    \"question\": \"邻接表存储时的拓扑排序的时间复杂度是[F##O(|V|+|E|)]\\n邻接矩阵存储时拓扑排序的时间复杂度是[F##O(\\\\(|V|^2\\\\))]\",\n995\t    \"answer\": \"\"\n996\t  },\n997\t  {\n998\t    \"category\": \"ds\",\n999\t    \"question\": \"拓扑排序的结果通常[F##不唯一]\",\n1000\t    \"answer\": \"\"\n1001\t  },\n1002\t  {\n1003\t    \"category\": \"ds\",\n1004\t    \"question\": \"按拓扑排序的结果对顶点重新编号，生成AOV网新的邻接矩阵\\n这种邻接矩阵是[F##三角矩阵]\",\n1005\t    \"answer\": \"对于一般的图来说，若其邻接矩阵是三角矩阵，则存在拓扑序列\\n反之不成立\"\n1006\t  },\n1007\t  {\n1008\t    \"category\": \"ds\",\n1009\t    \"question\": \"求逆拓扑排序的步骤是：\\n1.从AOV网中选择[F##一个没有后继（出度为0）的顶点并输出]\\n\\n2.从网中[F##删除该顶点和所有以它为终点的有向边]\\n\\n3.重复1和2直到当前的AOV网为空\",\n1010\t    \"answer\": \"\"\n1011\t  },\n1012\t  {\n1013\t    \"category\": \"ds\",\n1014\t    \"question\": \"在带权图中，以顶点表示事件，有向边表示活动，以边上的权值表示完成该活动的开销\\n称之为[F##用边表示活动的网络]，简称[F##AOE网]\",\n1015\t    \"answer\": \"\"\n1016\t  },\n1017\t  {\n1018\t    \"category\": \"ds\",\n1019\t    \"question\": \"AOE网中仅有一个入度为0的顶点，称为[F##开始顶点（源点）]\\n仅存在一个出度为0的顶点，称为[F##结束顶点（汇点）]\",\n1020\t    \"answer\": \"\"\n1021\t  },\n1022\t  {\n1023\t    \"category\": \"ds\",\n1024\t    \"question\": \"AOE网的关键路径是[F##从源点到汇点的具有最大路径长度的路径]\\n关键路径上的活动称为[F##关键活动]\",\n1025\t    \"answer\": \"\"\n1026\t  },\n1027\t  {\n1028\t    \"category\": \"ds\",\n1029\t    \"question\": \"缩短关键活动，该关键活动就可能[F##变成非关键活动]\",\n1030\t    \"answer\": \"\"\n1031\t  },\n1032\t  {\n1033\t    \"category\": \"ds\",\n1034\t    \"question\": \"关键路径通常[F##不唯一]，只有加快那些[F##包括在所有关键路径上的关键活动]才能达到缩短工期的目的\",\n1035\t    \"answer\": \"\"\n1036\t  },\n1037\t  {\n1038\t    \"category\": \"ds\",\n1039\t    \"question\": \"求最短路径允许图[F##有环]\",\n1040\t    \"answer\": \"\"\n1041\t  },\n1042\t  {\n1043\t    \"category\": \"ds\",\n1044\t    \"question\": \"若DAG图的拓扑序列唯一，[F##不能]唯一确定该图\",\n1045\t    \"answer\": \"\"\n1046\t  },\n1047\t  {\n1048\t    \"category\": \"ds\",\n1049\t    \"question\": \"Kruskal算法和prim算法的区别是\\nkruskal每次[F##只选择最短边且不会构成环]\\n\\nprim算法要找[F##从已连接顶点出发的最短边]\",\n1050\t    \"answer\": \"\"\n1051\t  },\n1052\t  {\n1053\t    \"category\": \"ds\",\n1054\t    \"question\": \"单独一个结点[F##可以算作]一个强连通分量\",\n1055\t    \"answer\": \"\"\n1056\t  },\n1057\t  {\n1058\t    \"category\": \"ds\",\n1059\t    \"question\": \"Dijkstra生成的树[F##不一定是]最小生成树\",\n1060\t    \"answer\": \"\"\n1061\t  },\n1062\t  {\n1063\t    \"category\": \"ds\",\n1064\t    \"question\": \"DFS获取拓扑序列的方法是[F##在DFS过程中设定一个时间标记，DFS调用结束时对各结点计时，按结束时间从大到小可以得到一个拓扑序列]\",\n1065\t    \"answer\": \"\"\n1066\t  },\n1067\t  {\n1068\t    \"category\": \"ds\",\n1069\t    \"question\": \"平均查找长度ASL=[F##\\\\(\\\\sum_{i=1}^nP_iC_i\\\\)]\",\n1070\t    \"answer\": \"\\\\(C_i\\\\)是查找第i个顶点的比较次数\"\n1071\t  },\n1072\t  {\n1073\t    \"category\": \"ds\",\n1074\t    \"question\": \"顺序查找中，0号位置的元素称为[F##哨兵（值=key）]\\n引入其的目的是[F##防止越界，减少非必要的判断语句，提高程序效率]\",\n1075\t    \"answer\": \"\"\n1076\t  },\n1077\t  {\n1078\t    \"category\": \"ds\",\n1079\t    \"question\": \"对于顺序查找\\n\\\\(ASL_{成功}\\\\)=[F##\\\\(\\\\sum_{i=1}^nP_i(n-i+1)\\\\)]\\n\\n\\\\(ASL_{失败}\\\\)=[F##n+1]\\n\\n特别的，对于有序表的顺序查找\\n\\n\\\\(ASL_{失败}\\\\)=[F##\\\\(\\\\frac{n}{2}+\\\\frac{n}{n+1}\\\\)]\",\n1080\t    \"answer\": \"\"\n1081\t  },\n1082\t  {\n1083\t    \"category\": \"ds\",\n1084\t    \"question\": \"折半查找的判定树是[F##平衡二叉树]\",\n1085\t    \"answer\": \"\"\n1086\t  },\n1087\t  {\n1088\t    \"category\": \"ds\",\n1089\t    \"question\": \"等概率情况下，折半查找成功时的ASL=[F##\\\\(\\\\frac{n+1}{n}\\\\log_2(n+1)-1\\\\)]\",\n1090\t    \"answer\": \"\"\n1091\t  },\n1092\t  {\n1093\t    \"category\": \"ds\",\n1094\t    \"question\": \"折半查找的时间复杂度是[F##\\\\(O(\\\\log_2n)\\\\)]\",\n1095\t    \"answer\": \"平均情况下比顺序查找效率高\"\n1096\t  },\n1097\t  {\n1098\t    \"category\": \"ds\",\n1099\t    \"question\": \"分块查找，块内元素[F##可以无序]，块间元素[F##有序]\",\n1100\t    \"answer\": \"\"\n1101\t  },\n1102\t  {\n1103\t    \"category\": \"ds\",\n1104\t    \"question\": \"分块查找，第一步[F##顺序查找或折半查找索引表]\\n第二步[F##表内顺序查找]\",\n1105\t    \"answer\": \"\"\n1106\t  },\n1107\t  {\n1108\t    \"category\": \"ds\",\n1109\t    \"question\": \"分块查找\\n将长度为n的查找表均匀地分成b块，每块有s个记录，在等概率的条件下\\n对索引表采用顺序查找的ASL=[F##\\\\(\\\\frac{s^2+2s+n}{2s}\\\\)] &nbsp;当s=[F##\\\\(\\\\sqrt{n}\\\\)]时取得最小值为[F##\\\\(\\\\sqrt{n}+1\\\\)]\\n\\n对索引表采用折半查找的ASL=[F##\\\\(\\\\lceil\\\\log_2(b+1)\\\\rceil+\\\\frac{s+1}{2}\\\\)]\",\n1110\t    \"answer\": \"\"\n1111\t  },\n1112\t  {\n1113\t    \"category\": \"ds\",\n1114\t    \"question\": \"二叉排序树的非递归查找的最坏空间复杂度是[F##O(1)]\\n递归查找的最坏空间复杂度是[F##O(h)]\",\n1115\t    \"answer\": \"h为树高\"\n1116\t  },\n1117\t  {\n1118\t    \"category\": \"ds\",\n1119\t    \"question\": \"二叉排序树的插入的递归实现，最坏空间复杂度为[F##O(h)]\",\n1120\t    \"answer\": \"\"\n1121\t  },\n1122\t  {\n1123\t    \"category\": \"ds\",\n1124\t    \"question\": \"二叉排序树插入的结点[F##一定是一个新添加的叶结点]\\n且是[F##查找失败时的查找路径上访问的最后一个结点的孩子]\",\n1125\t    \"answer\": \"\"\n1126\t  },\n1127\t  {\n1128\t    \"category\": \"ds\",\n1129\t    \"question\": \"不同关键字序列得到的二叉排序树[F##可能相同也可能不同]\",\n1130\t    \"answer\": \"\"\n1131\t  },\n1132\t  {\n1133\t    \"category\": \"ds\",\n1134\t    \"question\": \"二叉排序树的删除操作的实现过程按3种情况来处理\\n1.若被删除结点z上叶结点，则[F##直接删除，不会破坏二叉排序树的性质]\\n\\n2.若结点z只有一棵左子树或右子树，则[F##让z的子树成为z父结点的子树，替代z的位置]\\n\\n3.若结点z有左右两颗子树，则[F##令z的中序直接后继（或直接前驱）替代z（z复制其数据），然后从二叉排序树中删去这个直接后继（前驱），这样就转换成了1或2的情况]\",\n1135\t    \"answer\": \"\"\n1136\t  },\n1137\t  {\n1138\t    \"category\": \"ds\",\n1139\t    \"question\": \"二叉排序树的中序遍历中，一个结点的后继一定没有[F##左子树]，一个结点的前驱一定没有[F##右子树]\",\n1140\t    \"answer\": \"\"\n1141\t  },\n1142\t  {\n1143\t    \"category\": \"ds\",\n1144\t    \"question\": \"二叉排序树的查找效率主要取决于[F##树的高度]\",\n1145\t    \"answer\": \"\"\n1146\t  },\n1147\t  {\n1148\t    \"category\": \"ds\",\n1149\t    \"question\": \"二叉排序树的插入删除操作的平均时间复杂度是[F##\\\\(O(\\\\log_2n)\\\\)]\",\n1150\t    \"answer\": \"\"\n1151\t  },\n1152\t  {\n1153\t    \"category\": \"ds\",\n1154\t    \"question\": \"二分查找与二叉排序树的选择\\n当有序表是静态查找表时，宜用[F##二分查找]\\n当有序表是动态查找表时，宜用[F##二叉排序树]\",\n1155\t    \"answer\": \"\"\n1156\t  },\n1157\t  {\n1158\t    \"category\": \"ds\",\n1159\t    \"question\": \"二叉排序树的简写是[F##BST]\",\n1160\t    \"answer\": \"\"\n1161\t  },\n1162\t  {\n1163\t    \"category\": \"ds\",\n1164\t    \"question\": \"平衡二叉树（AVL）的定义是[F##任意结点的左右子树高度差的绝对值不超过1]\",\n1165\t    \"answer\": \"\"\n1166\t  },\n1167\t  {\n1168\t    \"category\": \"ds\",\n1169\t    \"question\": \"平衡二叉树的平衡因子是[F##结点左子树与右子树的高度差]\\n平衡因子的值只可能是[F##-1、0、1]\",\n1170\t    \"answer\": \"\"\n1171\t  },\n1172\t  {\n1173\t    \"category\": \"ds\",\n1174\t    \"question\": \"平衡二叉树，在插入或删除一个结点时，要[F##先检查其插入路径上的结点是否因为此次操作而导致了不平衡]\\n若导致了不平衡，则[F##先找到离插入结点最近的平衡因子的绝对值大于1的结点A，再对以A为根的子树，在保持二叉排序树的前提下调整各结点的位置关系，使之重新达到平衡]\",\n1175\t    \"answer\": \"\"\n1176\t  },\n1177\t  {\n1178\t    \"category\": \"ds\",\n1179\t    \"question\": \"AVL树，在结点A的左孩子（L）的左子树（L）上插入新结点，要进行[F##LL平衡旋转（右单旋转）]\",\n1180\t    \"answer\": \"\"\n1181\t  },\n1182\t  {\n1183\t    \"category\": \"ds\",\n1184\t    \"question\": \"LL平衡旋转的步骤是\\n1.A的左孩子B[F##向右上旋转代替A成为根结点]\\n\\n2.将A结点[F##向右下旋转成为B的右子树的根结点]\\n\\n3.将[F##B的原右子树]作为A结点的左子树\",\n1185\t    \"answer\": \"\"\n1186\t  },\n1187\t  {\n1188\t    \"category\": \"ds\",\n1189\t    \"question\": \"AVL树，在结点A的右孩子（R）的右子树（R）上插入了一个新结点，需要对A做[F##RR平衡旋转（左单旋转）]\",\n1190\t    \"answer\": \"\"\n1191\t  },\n1192\t  {\n1193\t    \"category\": \"ds\",\n1194\t    \"question\": \"RR平衡旋转的步骤是\\n1.将A的右孩子B[F##向左上旋转替代A成为根结点]\\n\\n2.将A结点[F##向左下旋转成为B的左子树的根结点]\\n\\n3.将[F##B的原左子树]作为A的右子树\",\n1195\t    \"answer\": \"\"\n1196\t  },\n1197\t  {\n1198\t    \"category\": \"ds\",\n1199\t    \"question\": \"AVL树，在A的左孩子的右子树上插入新结点，要对A进行[F##LR平衡旋转（先左后右双旋转）]\",\n1200\t    \"answer\": \"\"\n1201\t  },\n1202\t  {\n1203\t    \"category\": \"ds\",\n1204\t    \"question\": \"LR平衡旋转的步骤是\\n1.先对A结点的左孩子B的右子树的根结点C做[F##RR平衡旋转（左单旋转）]\\n\\n2.再对C做[F##LL平衡旋转（右单旋转）]\",\n1205\t    \"answer\": \"\"\n1206\t  },\n1207\t  {\n1208\t    \"category\": \"ds\",\n1209\t    \"question\": \"AVL树，当在A的右孩子的左子树上插入新结点时，要对其做[F##RL平衡旋转（先右后左双旋转）]\",\n1210\t    \"answer\": \"\"\n1211\t  },\n1212\t  {\n1213\t    \"category\": \"ds\",\n1214\t    \"question\": \"RL平衡旋转的步骤是\\n1.先对A结点的右孩子B的左子树的根结点C做[F##LL平衡旋转（右单旋转）]\\n\\n2.再对C做[F##RR平衡旋转（左单旋转）]\",\n1215\t    \"answer\": \"\"\n1216\t  },\n1217\t  {\n1218\t    \"category\": \"ds\",\n1219\t    \"question\": \"AVL树删除结点的步骤\\n1.删除结点（方法同平衡二叉树）\\n\\n2.从被删除结点[F##向上找最小不平衡子树]，找不到就结束\\n\\n3.找最小不平衡子树下[F##高度最高的儿子、孙子]\\n\\n4.根据[F##孙子]的位置调整平衡\\n\\n5.若还是不平衡则向上传导，继续2\",\n1220\t    \"answer\": \"\"\n1221\t  },\n1222\t  {\n1223\t    \"category\": \"ds\",\n1224\t    \"question\": \"平衡二叉树的最大深度为[F##\\\\(O(\\\\log_2n)\\\\)]\\n平均查找长度为[F##\\\\(O(\\\\log_2n)\\\\)]\",\n1225\t    \"answer\": \"\"\n1226\t  },\n1227\t  {\n1228\t    \"category\": \"ds\",\n1229\t    \"question\": \"红黑树是满足如下红黑性质的二叉排序树：\\n1.每个结点或是红色，或是黑色\\n\\n2.根结点是[F##黑色的]\\n\\n3.叶结点（虚拟的外部结点，NULL结点（失败结点））都是[F##黑色的]\\n\\n4.不存在两个相邻的[F##红结点（即红结点的父结点和孩子结点均是黑色的）]\\n\\n5.对每个结点，从该结点到任意一个叶结点的简单路径上，所含[F##黑结点]的数量相同\",\n1230\t    \"answer\": \"\"\n1231\t  },\n1232\t  {\n1233\t    \"category\": \"ds\",\n1234\t    \"question\": \"黑高为h的红黑树，内部结点至少有[F##\\\\(2^h-1\\\\)]个\",\n1235\t    \"answer\": \"\"\n1236\t  },\n1237\t  {\n1238\t    \"category\": \"ds\",\n1239\t    \"question\": \"结点的黑高是[F##从某结点出发（不含该结点）到达一个叶结点的任意一个简单路径上的黑结点总数]\\n红黑树的黑高是[F##根结点的黑高]\",\n1240\t    \"answer\": \"\"\n1241\t  },\n1242\t  {\n1243\t    \"category\": \"ds\",\n1244\t    \"question\": \"红黑树从根到叶结点的最长路径[F##不大于最短路径的2倍]\",\n1245\t    \"answer\": \"\"\n1246\t  },\n1247\t  {\n1248\t    \"category\": \"ds\",\n1249\t    \"question\": \"有n个内部结点的红黑树高度h[F##\\\\(\\\\leq2\\\\log_2(n+1)\\\\)]\",\n1250\t    \"answer\": \"\"\n1251\t  },\n1252\t  {\n1253\t    \"category\": \"ds\",\n1254\t    \"question\": \"红黑树的查找时间复杂度为[F##\\\\(O(\\\\log_2n)\\\\)]\",\n1255\t    \"answer\": \"\"\n1256\t  },\n1257\t  {\n1258\t    \"category\": \"ds\",\n1259\t    \"question\": \"红黑树和AVL树的选择\\n查找操作比较多适合[F##AVL树]，否则适合[F##红黑树]\",\n1260\t    \"answer\": \"\"\n1261\t  },\n1262\t  {\n1263\t    \"category\": \"ds\",\n1264\t    \"question\": \"新插入红黑树中的结点初始颜色为[F##红色]\",\n1265\t    \"answer\": \"\"\n1266\t  },\n1267\t  {\n1268\t    \"category\": \"ds\",\n1269\t    \"question\": \"红黑树删除的时间复杂度为[F##\\\\(O(\\\\log_2n)\\\\)]\",\n1270\t    \"answer\": \"\"\n1271\t  },\n1272\t  {\n1273\t    \"category\": \"ds\",\n1274\t    \"question\": \"m阶B树是[F##所有结点的平衡因子均等于0的m路平衡查找树]\",\n1275\t    \"answer\": \"任意结点所有子树高度都相同\"\n1276\t  },\n1277\t  {\n1278\t    \"category\": \"ds\",\n1279\t    \"question\": \"m阶B树的特性有：\\n1.树中每个结点至多有[F##m]棵子树，[F##m-1]个关键字\\n\\n2.若根结点不是叶结点，则[F##至少有两棵子树]\\n\\n3.除根结点外的所有非叶结点至少有[F##\\\\(\\\\lceil\\\\frac{m}{2}\\\\rceil\\\\)]棵子树，即至少含有[F##\\\\(\\\\lceil\\\\frac{m}{2}\\\\rceil-1\\\\)]个关键字\\n\\n4.所有非叶结点的结构为[F##\\\\(n | P_0 | K_1 | P_1 | K_2 | … | K_n | P_n |\\\\)](k为关键字，p为指向子树的指针)\\n\\n5.结点内关键字[F##升序排列]\\n\\n6.所有叶结点都出现在同一层次上，并且[F##不带信息（视为失败结点）]\",\n1280\t    \"answer\": \"\"\n1281\t  },\n1282\t  {\n1283\t    \"category\": \"ds\",\n1284\t    \"question\": \"B树结点的孩子个数=[F##该结点中关键字的个数+1]\",\n1285\t    \"answer\": \"\"\n1286\t  },\n1287\t  {\n1288\t    \"category\": \"ds\",\n1289\t    \"question\": \"B树的高度[F##不包括]不带信息的叶结点所处的那一层\",\n1290\t    \"answer\": \"\"\n1291\t  },\n1292\t  {\n1293\t    \"category\": \"ds\",\n1294\t    \"question\": \"一棵高度为h的m阶B树中关键字的个数n满足[F##\\\\(2(\\\\lceil\\\\frac{m}{2}\\\\rceil^{h-1})-1\\\\)]\\\\(\\\\leq n\\\\leq\\\\)[F##\\\\(m^h-1\\\\)]\",\n1295\t    \"answer\": \"\"\n1296\t  },\n1297\t  {\n1298\t    \"category\": \"ds\",\n1299\t    \"question\": \"一棵高度为h的m阶层B树\\n[F##\\\\(\\\\log_m(n+1)\\\\)]\\\\(\\\\leq h\\\\leq\\\\)[F##\\\\(\\\\log_{\\\\lceil\\\\frac{m}{2}\\\\rceil}(\\\\frac{n+1}{2})+1\\\\)]\",\n1300\t    \"answer\": \"\"\n1301\t  },\n1302\t  {\n1303\t    \"category\": \"ds\",\n1304\t    \"question\": \"对于关键字个数为n的B树，叶结点即查找不成功的结点个数为[F##n+1]\",\n1305\t    \"answer\": \"n+1种失败方式\"\n1306\t  },\n1307\t  {\n1308\t    \"category\": \"ds\",\n1309\t    \"question\": \"B树的查找包括两个基本操作\\n1.在B树找结点\\n\\n2.在结点内找关键字\\n\\n前者在[F##磁盘]上进行\\n\\n后者在[F##内存]中进行\",\n1310\t    \"answer\": \"找到目标结点后先将结点信息读入内存，再在结点内顺序或折半查找\"\n1311\t  },\n1312\t  {\n1313\t    \"category\": \"ds\",\n1314\t    \"question\": \"B树的插入分为两步\\n1.定位。插入位置一定是[F##最底层中的某个非叶结点]\\n\\n2.插入。插入后检查结点内关键字个数，当插入后结点内关键字个数[F##大于m-1]时，必须对结点进行分裂\",\n1315\t    \"answer\": \"\"\n1316\t  },\n1317\t  {\n1318\t    \"category\": \"ds\",\n1319\t    \"question\": \"B树插入时对结点的分裂的方法是\\n从[F##中间位置\\\\(\\\\lceil\\\\frac{m}{2}\\\\rceil\\\\)]将关键字分为两部分\\n\\n左部分包含的关键字放在原结点中\\n\\n右部分包含的关键字放入新结点中\\n\\n中间位置的结点[F##插入原结点的父结点]\\n\\n若此时导致其父结点的关键字个数也超过上限，继续进行分裂操作，直到这个过程传递到根结点为止\",\n1320\t    \"answer\": \"\"\n1321\t  },\n1322\t  {\n1323\t    \"category\": \"ds\",\n1324\t    \"question\": \"B树的删除\\n若被删关键字k不在终端结点时，可以用[F##k的前驱或后继]k'来代替k，然后在相应结点中删除k‘，转换为下一种情况\\n\\n当被删关键字在终端结点中时，存在下列三种情况\\n\\n1.若[F##被删关键字所在结点的关键字个数\\\\(\\\\geq\\\\lceil\\\\frac{m}{2}\\\\rceil\\\\)] ,直接删去关键字\\n\\n2.若兄弟够借，[F##调整兄弟结点和双亲结点，以达到新的平衡]\\n\\n3.若兄弟不够借，[F##将关键字删除后与兄弟结点和双亲结点中的关键字合并]\\n\\n合并过程中，双亲结点的关键字个数会减一，若其双亲结点是根结点且关键字减少至0，则[F##直接将根结点删除，合并后的新结点成为根]\\n\\n否则视情况将双亲结点与兄弟结点进行调整合并操作并重复上述步骤\",\n1325\t    \"answer\": \"\"\n1326\t  },\n1327\t  {\n1328\t    \"category\": \"ds\",\n1329\t    \"question\": \"红黑树插入结点z的步骤如下\\n1.用二叉查找树插入法插入，并将结点z染为红色。若结点z的父结点是黑色的，则无须任何更改\\n\\n2.如果结点z是根结点，则[F##将z着为黑色]\\n\\n3.若z不是根结点，且父结点是红色的，则分以下情况：\\n\\n黑叔：[F##根据结点所在位置选择旋转方式，后将父结点和爷结点颜色取反]\\n\\n红叔：[F##叔父爷结点颜色取反，爷结点当新结点处理]\\n\\n<br>\\n\\n满足红叔条件就会不断循环，直到满足黑叔条件\",\n1330\t    \"answer\": \"注意空节点是黑色的\"\n1331\t  },\n1332\t  {\n1333\t    \"category\": \"ds\",\n1334\t    \"question\": \"m阶B+树的性质\\n1.每个分支结点最多有[F##m]棵子树\\n\\n2.非叶根结点至少有[F##2]棵子树，其他每个分支结点至少有[F##\\\\(\\\\lceil\\\\frac{m}{2}\\\\rceil\\\\)]棵子树\\n\\n3.结点的子树个数与关键字个数[F##相等（与B树的区别）]\\n\\n4.所有叶结点包含全部关键字及指向相应记录的指针，叶结点中将关键字按大小顺序排列，并将相邻叶结点[F##按大小顺序相互连接起来（支持顺序查找）]\\n\\n5.所有分支结点（可视为索引的索引）中仅包含它的各个子结点（即下一级索引块）中[F##关键字的最大值]及指向其子结点的指针（可用于分块查找）\",\n1335\t    \"answer\": \"\"\n1336\t  },\n1337\t  {\n1338\t    \"category\": \"ds\",\n1339\t    \"question\": \"m阶B+树和B树的主要差异有\\nB+树中，具有n个关键字的结点含有[F##n]棵子树\\n\\nB树中，具有n个关键字的结点含有[F##n+1]棵子树\",\n1340\t    \"answer\": \"\"\n1341\t  },\n1342\t  {\n1343\t    \"category\": \"ds\",\n1344\t    \"question\": \"m阶B+树和B树的主要差异有\\n\\nB+树中，每个结点（非根内部结点）的关键字个数n的范围是[F##\\\\(\\\\lceil\\\\frac{m}{2}\\\\rceil\\\\leq n\\\\leq m\\\\)]根结点:\\\\(1\\\\leq n\\\\leq m\\\\)<br>\\n\\n\\nB树中，每个结点（非根内部结点）的关键字个数n的范围是[F##\\\\(\\\\lceil\\\\frac{m}{2}\\\\rceil-1\\\\leq n\\\\leq m-1\\\\)]根结点:\\\\(1\\\\leq n\\\\leq m-1\\\\)&nbsp;&nbsp;\\n\\n\\n<br>\",\n1345\t    \"answer\": \"\"\n1346\t  },\n1347\t  {\n1348\t    \"category\": \"ds\",\n1349\t    \"question\": \"m阶B+树和B树的主要差异有&nbsp;\\n\\n3.在B+树中，叶结点包含了[F##全部关键字]，非叶结点的中出现的关键字[F##也会出现在叶结点中]\\n\\n\\nB树中，终端结点所包含的关键字和其他结点包含的关键字[F##不重复]\",\n1350\t    \"answer\": \"\"\n1351\t  },\n1352\t  {\n1353\t    \"category\": \"ds\",\n1354\t    \"question\": \"m阶B+树和B树的主要差异有\\n\\nB+树中，叶结点包含信息，所有非叶结点[F##仅起索引作用，不含有该关键字对应记录的存储地址]\",\n1355\t    \"answer\": \"\"\n1356\t  },\n1357\t  {\n1358\t    \"category\": \"ds\",\n1359\t    \"question\": \"B+树在查找过程中，非叶结点上的关键字值等于给定值时[F##不停止，继续向下查找，直到叶结点上的该关键字为止]\",\n1360\t    \"answer\": \"\"\n1361\t  },\n1362\t  {\n1363\t    \"category\": \"ds\",\n1364\t    \"question\": \"具有n个关键字的m阶B树，应有[F##n+1]个叶结点\",\n1365\t    \"answer\": \"叶结点代表查找失败的情况，共有n+1种失败的情况\"\n1366\t  },\n1367\t  {\n1368\t    \"category\": \"ds\",\n1369\t    \"question\": \"基于比较的排序，对任意n个关键字排序的比较次数至少为[F##\\\\(\\\\lceil\\\\log_2(n!)\\\\rceil\\\\)]\",\n1370\t    \"answer\": \"\"\n1371\t  },\n1372\t  {\n1373\t    \"category\": \"ds\",\n1374\t    \"question\": \"插入排序的基本思想是[F##每次将一个待排序的记录按其关键字大小插入前面已排好序的子序列]\",\n1375\t    \"answer\": \"\"\n1376\t  },\n1377\t  {\n1378\t    \"category\": \"ds\",\n1379\t    \"question\": \"插入排序的步骤是[F##从左向右选择元素，从被选择元素的位置从后向前比较，并根据比较结构反复把已排序元素向后移位（若被选择元素的前一个元素大于被选择元素则交换两者）]\",\n1380\t    \"answer\": \"可以用哨兵节省交换时间，直接将元素后移，最后将哨兵元素赋值给目标位置\"\n1381\t  },\n1382\t  {\n1383\t    \"category\": \"ds\",\n1384\t    \"question\": \"直接插入排序的空间复杂度为[F##O(1)]\\n最好时间复杂度为[F##O(n)]\\n\\n最坏时间复杂度为[F##\\\\(O(n^2)\\\\)]\\n\\n平均时间复杂度为[F##\\\\(O(n^2)\\\\)]\",\n1385\t    \"answer\": \"\"\n1386\t  },\n1387\t  {\n1388\t    \"category\": \"ds\",\n1389\t    \"question\": \"直接插入排序是[F##稳定]的排序算法\",\n1390\t    \"answer\": \"\"\n1391\t  },\n1392\t  {\n1393\t    \"category\": \"ds\",\n1394\t    \"question\": \"折半插入排序对插入排序的改良是[F##查找插入位置时用折半查找]\",\n1395\t    \"answer\": \"\"\n1396\t  },\n1397\t  {\n1398\t    \"category\": \"ds\",\n1399\t    \"question\": \"折半排序仅[F##减少了比较元素的次数（约为\\\\(O(n\\\\log_2n)\\\\)）]，元素移动的次数[F##未改变]\",\n1400\t    \"answer\": \"\"\n1401\t  },\n1402\t  {\n1403\t    \"category\": \"ds\",\n1404\t    \"question\": \"折半插入排序适合[F##数据量不很大的排序表]\",\n1405\t    \"answer\": \"\"\n1406\t  },\n1407\t  {\n1408\t    \"category\": \"ds\",\n1409\t    \"question\": \"折半插入排序是一种[F##稳定的]排序方法\",\n1410\t    \"answer\": \"low=mid+1保证算法稳定性\"\n1411\t  },\n1412\t  {\n1413\t    \"category\": \"ds\",\n1414\t    \"question\": \"直接插入排序适合[F##基本有序的排序表和数据量不大的排序表]\",\n1415\t    \"answer\": \"\"\n1416\t  },\n1417\t  {\n1418\t    \"category\": \"ds\",\n1419\t    \"question\": \"希尔排序又称[F##缩小增量排序]\",\n1420\t    \"answer\": \"\"\n1421\t  },\n1422\t  {\n1423\t    \"category\": \"ds\",\n1424\t    \"question\": \"希尔排序的基本思想是[F##把待排序表分割成有相隔某个增量的记录组成的多个子表，对各个子表进行直接插入排序，当整个表中的元素已呈基本有序时，再对全体记录进行一次直接插入排序]\",\n1425\t    \"answer\": \"\"\n1426\t  },\n1427\t  {\n1428\t    \"category\": \"ds\",\n1429\t    \"question\": \"希尔排序的稳定性是[F##不稳定]\",\n1430\t    \"answer\": \"\"\n1431\t  },\n1432\t  {\n1433\t    \"category\": \"ds\",\n1434\t    \"question\": \"希尔排序仅适用于线性表为[F##顺序]存储的情况\",\n1435\t    \"answer\": \"\"\n1436\t  },\n1437\t  {\n1438\t    \"category\": \"ds\",\n1439\t    \"question\": \"希尔排序的步骤是\\n1.所有距离为\\\\(d_1\\\\)的倍数的记录放在同一组，在各组内进行[F##直接插入排序]\\n\\n2.然后取第二个步长[F##\\\\(d_2<d_1\\\\)],重复上述过程，直到取到[F##步长为1]，再进行[F##直接插入排序]\",\n1440\t    \"answer\": \"\"\n1441\t  },\n1442\t  {\n1443\t    \"category\": \"ds\",\n1444\t    \"question\": \"对有n个元素的顺序表采用直接插入排序算法进行排序\\n最坏情况下需要的比较次数是[F##\\\\(\\\\frac{n(n-1)}{2}\\\\)]次\\n\\n最好情况下所需的比较次数是[F##n-1]次\",\n1445\t    \"answer\": \"\"\n1446\t  },\n1447\t  {\n1448\t    \"category\": \"ds\",\n1449\t    \"question\": \"冒泡排序的基本思想是：从后往前（或从前往后）[F##两两比较相邻元素的值，若为逆序则交换，直到序列比较完]\",\n1450\t    \"answer\": \"\"\n1451\t  },\n1452\t  {\n1453\t    \"category\": \"ds\",\n1454\t    \"question\": \"每趟冒泡的结果是[F##确定一个元素的最终位置]\",\n1455\t    \"answer\": \"\"\n1456\t  },\n1457\t  {\n1458\t    \"category\": \"ds\",\n1459\t    \"question\": \"最多做[F##n-1] 趟冒泡就能把所有元素排好序\\n[F##某一趟排序未发生交换]时，算法可提前结束<br>\",\n1460\t    \"answer\": \"\"\n1461\t  },\n1462\t  {\n1463\t    \"category\": \"ds\",\n1464\t    \"question\": \"冒泡排序的空间复杂度为[F##O(1)]\\n最坏情况下的时间复杂度为[F##\\\\(O(n^2)\\\\)]\\n\\n平均时间复杂度为[F##\\\\(O(n^2)\\\\)]\",\n1465\t    \"answer\": \"\"\n1466\t  },\n1467\t  {\n1468\t    \"category\": \"ds\",\n1469\t    \"question\": \"冒泡排序的稳定性是[F##稳定]\",\n1470\t    \"answer\": \"相等时不发生交换\"\n1471\t  },\n1472\t  {\n1473\t    \"category\": \"ds\",\n1474\t    \"question\": \"快速排序的基本思想是\\n1.在待排序表L[1…n]中任取一个元素pivot作为[F##枢轴（基准）]\\n\\n2.通过一趟排序将待排序表划分为独立的两部分L[1…k-1]和L[k+1…n]\\n\\n使得L[1…k-1]中的所有元素[F##小于pivot]，L[k+1…n]中的所有元素[F##大于或等于pivot]\\n\\n则pivot放在了[F##最终位置L(k)]上，这个过程称为[F##一次划分]\\n\\n3.分别递归地对两个子表重复上述过程，直到每部分只有一个元素或为空为止\",\n1475\t    \"answer\": \"pivot通常取首元素\"\n1476\t  },\n1477\t  {\n1478\t    \"category\": \"ds\",\n1479\t    \"question\": \"快排的代码分为两部分[F##划分算法Partition]和[F##排序算法QuickSort]\",\n1480\t    \"answer\": \"\"\n1481\t  },\n1482\t  {\n1483\t    \"category\": \"ds\",\n1484\t    \"question\": \"快排代码中，划分算法返回的是[F##枢轴的最终位置]\\n其负责的任务是[F##将枢轴放到最终位置]\",\n1485\t    \"answer\": \"\"\n1486\t  },\n1487\t  {\n1488\t    \"category\": \"ds\",\n1489\t    \"question\": \"快排代码中，排序算法的任务是[F##获取枢轴位置再递归对两子表进行排序]\",\n1490\t    \"answer\": \"\"\n1491\t  },\n1492\t  {\n1493\t    \"category\": \"ds\",\n1494\t    \"question\": \"快排的空间复杂度\\n最好情况下为[F##\\\\(O(\\\\log_2n)\\\\)]\\n最坏情况下为[F##\\\\(O(n)\\\\)]\\n\\n\\n平均情况下为[F##\\\\(O(\\\\log_2n)\\\\)]\",\n1495\t    \"answer\": \"\"\n1496\t  },\n1497\t  {\n1498\t    \"category\": \"ds\",\n1499\t    \"question\": \"快排过程中[F##并不产生]有序子序列\",\n1500\t    \"answer\": \"\"\n1501\t  },\n1502\t  {\n1503\t    \"category\": \"ds\",\n1504\t    \"question\": \"快排的时间复杂度\\n最坏情况下[F##\\\\(O(n^2)\\\\)]\\n\\n最理想情况下[F##\\\\(O(n\\\\log_2n)\\\\)]\",\n1505\t    \"answer\": \"最坏情况为基本有序或基本逆序的初始排序表\"\n1506\t  },\n1507\t  {\n1508\t    \"category\": \"ds\",\n1509\t    \"question\": \"快排的稳定性是[F##不稳定]\",\n1510\t    \"answer\": \"\"\n1511\t  },\n1512\t  {\n1513\t    \"category\": \"ds\",\n1514\t    \"question\": \"提高快排效率的方法之一是[F##尽可能选取一个可以将数据中分的枢轴元素]\",\n1515\t    \"answer\": \"\"\n1516\t  },\n1517\t  {\n1518\t    \"category\": \"ds\",\n1519\t    \"question\": \"选择排序的基本思想是[F##第i趟在后面的n-i+1个待排元素中选取关键字最小的元素，作为有序子序列的第i个元素]\",\n1520\t    \"answer\": \"\"\n1521\t  },\n1522\t  {\n1523\t    \"category\": \"ds\",\n1524\t    \"question\": \"简单选择排序的基本思想是[F##每i趟从第i个元素向后扫选择最小的元素与i位置上的元素交换]\",\n1525\t    \"answer\": \"\"\n1526\t  },\n1527\t  {\n1528\t    \"category\": \"ds\",\n1529\t    \"question\": \"简单选择排序每趟排序[F##可以确定一个元素的最终位置]\",\n1530\t    \"answer\": \"\"\n1531\t  },\n1532\t  {\n1533\t    \"category\": \"ds\",\n1534\t    \"question\": \"简单选择排序的空间复杂度是[F##O（1）]\\n时间复杂度是[F##\\\\(O(n^2)\\\\)]\",\n1535\t    \"answer\": \"\"\n1536\t  },\n1537\t  {\n1538\t    \"category\": \"ds\",\n1539\t    \"question\": \"可以将堆视作[F##完全二叉树]\",\n1540\t    \"answer\": \"\"\n1541\t  },\n1542\t  {\n1543\t    \"category\": \"ds\",\n1544\t    \"question\": \"大根堆的最大元素存放在[F##根结点]\\n且其任意一个非根结点的值[F##小于或等于其双亲结点的值]\",\n1545\t    \"answer\": \"\"\n1546\t  },\n1547\t  {\n1548\t    \"category\": \"ds\",\n1549\t    \"question\": \"堆排序的思路是\\n1.建立初始堆\\n\\n2.推出堆顶元素后，通常将[F##堆底元素]送入堆顶\\n\\n3.此时大顶堆性质被破坏，将堆顶元素[F##向下调整使其继续保持大顶堆的性质]，再输出堆顶元素，如此重复\",\n1550\t    \"answer\": \"\"\n1551\t  },\n1552\t  {\n1553\t    \"category\": \"ds\",\n1554\t    \"question\": \"堆的构造方法是[F##从下向上依次调整堆使其满足堆的性质，直到根结点]\",\n1555\t    \"answer\": \"\"\n1556\t  },\n1557\t  {\n1558\t    \"category\": \"ds\",\n1559\t    \"question\": \"堆的插入操作的步骤是[F##将新结点放在堆的末端，再对这个新结点向上调整操作]\",\n1560\t    \"answer\": \"\"\n1561\t  },\n1562\t  {\n1563\t    \"category\": \"ds\",\n1564\t    \"question\": \"堆的删除操作是[F##用堆底元素元素替代被删除元素，再让该元素不断下坠]\",\n1565\t    \"answer\": \"\"\n1566\t  },\n1567\t  {\n1568\t    \"category\": \"ds\",\n1569\t    \"question\": \"堆排序的空间复杂度是[F##O(1)]\\n建堆的时间复杂度是[F##O(n)]\\n\\n每次调整的时间复杂度为[F##O(h)]\\n\\n总时间复杂度为[F##\\\\(O(n\\\\log_2n)\\\\)]\",\n1570\t    \"answer\": \"\"\n1571\t  },\n1572\t  {\n1573\t    \"category\": \"ds\",\n1574\t    \"question\": \"堆排序的稳定性是[F##不稳定]\",\n1575\t    \"answer\": \"\"\n1576\t  },\n1577\t  {\n1578\t    \"category\": \"ds\",\n1579\t    \"question\": \"2路归并排序的思想是将含有n个记录的带排序表视为[F##n个有序的子表]，然后两两